---
import "../styles/index.css";
import {
  getCases,
  getCostModulesA,
  getCostModulesB,
  getKitForScenario,
  getModuleMixFromRedPct,
  getNumberModuleAByPercent,
  getNumberModuleBByPercent,
  getTotalCost,
  inputLabels,
  KITS,
  PROPORTIONS_FACTORS,
  SCENARIO_KIT,
  snarioLabels,
} from "../lib/desition-engine.js";

const SCENARIO_LABELS = snarioLabels;

// 60 casos d'emergència del dataset
const CASES = getCases();
const defaultCase = CASES.find((c) => c.id === "EM059") ?? CASES[0];
const initialInput = { ...defaultCase.input };
const initialPercentA = getModuleMixFromRedPct(
  initialInput.pctConexionRed,
).percentModulesA;
const initialKit = getKitForScenario(initialInput.escenarioId);
const initialTotalCost = getTotalCost(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialModulesA = getNumberModuleAByPercent(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialModulesB = getNumberModuleBByPercent(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCostA = getCostModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCostB = getCostModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialBudget = initialInput.presupuestoTotalEur;
const initialOverBudget = initialTotalCost > initialBudget;

const formatEur = (val) =>
  `${Math.round(val).toLocaleString("ca-ES")} €`;
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Un quadre de comandament per decidir · ATOM Modular</title>
  </head>
  <body>
    <main class="page">
      <h1>Un quadre de comandament per decidir</h1>

      <div class="layout">
        <aside class="card sidebar">
          <h2>Dades del cas</h2>

          <div class="field">
            <label for="casoId">Cas d'emergència ({CASES.length})</label>
            <select id="casoId">
              {
                CASES.map((c) => (
                  <option value={c.id} selected={c.id === defaultCase.id}>
                    {c.label}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="field">
            <label for="escenarioId">{inputLabels.Clima}</label>
            <select id="escenarioId">
              {
                Object.entries(SCENARIO_LABELS).map(([k, lbl]) => (
                  <option value={k} selected={k === initialInput.escenarioId}>
                    {lbl}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="field">
            <label for="personasAfectadas">Persones afectades</label>
            <input
              id="personasAfectadas"
              type="number"
              min="0"
              step="1"
              value={initialInput.personasAfectadas}
            />
          </div>

          <div class="field">
            <label for="presupuestoTotalEur">Pressupost total (€)</label>
            <input
              id="presupuestoTotalEur"
              type="number"
              min="0"
              step="1000"
              value={initialBudget}
            />
          </div>

          <div class="field">
            <label for="percentModulesA">
              Mòduls autosuficients A (<span id="percentModulesAVal">{initialPercentA}</span>%)
            </label>
            <input
              id="percentModulesA"
              type="range"
              min="0"
              max="100"
              step="1"
              value={initialPercentA}
            />
            <div class="hint">
              <span>A (autosuficient): <strong id="hintPctA">{initialPercentA}%</strong></span>
              <span>B (amb xarxa): <strong id="hintPctB">{100 - initialPercentA}%</strong></span>
            </div>
          </div>
        </aside>

        <section>
          <div
            id="budgetBanner"
            class={`banner ${initialOverBudget ? "banner-no_arriba" : "banner-viable"}`}
          >
            <div>
              <span
                id="budgetBadge"
                class={`badge ${initialOverBudget ? "badge-no_arriba" : "badge-viable"}`}
              >
                {initialOverBudget ? "Supera el pressupost" : "Dins del pressupost"}
              </span>
              <strong id="budgetHeadline">
                {
                  initialOverBudget
                    ? `Excedeix en ${formatEur(initialTotalCost - initialBudget)}`
                    : `Queden lliures ${formatEur(initialBudget - initialTotalCost)}`
                }
              </strong>
            </div>
            <div id="budgetDetail" class="banner-detail">
              {
                initialOverBudget
                  ? `El cost calculat (${formatEur(initialTotalCost)}) supera el pressupost de ${formatEur(initialBudget)}.`
                  : `El cost calculat (${formatEur(initialTotalCost)}) s'ajusta al pressupost de ${formatEur(initialBudget)}.`
              }
            </div>
          </div>

          <div class="kpis">
            <div class="kpi">
              <div class="kpi-label">Cost total estimat</div>
              <div id="totalCostVal" class="kpi-val">
                {formatEur(initialTotalCost)}
              </div>
              <div id="totalCostSub" class="kpi-sub">
                {initialModulesA + initialModulesB} mòduls totals
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Mòduls A · Autosuficient</div>
              <div id="costAVal" class="kpi-val">{formatEur(initialCostA)}</div>
              <div id="modulesASub" class="kpi-sub">
                {initialModulesA} mòduls ({initialPercentA}%)
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Mòduls B · Amb xarxa</div>
              <div id="costBVal" class="kpi-val">{formatEur(initialCostB)}</div>
              <div id="modulesBSub" class="kpi-sub">
                {initialModulesB} mòduls ({100 - initialPercentA}%)
              </div>
            </div>
          </div>

          <div class="card">
            <div class="kit-header">
              <span
                id="kitBadge"
                class={`kit-badge kit-badge-${initialKit.id}`}
              >
                {initialKit.badge}
              </span>
              <div id="kitTitle" class="section-title">{initialKit.nom}</div>
            </div>

            <ul id="kitList" class="kit-list">
              {initialKit.components.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>
      </div>
    </main>

    <script define:vars={{ CASES, KITS, PROPORTIONS_FACTORS, SCENARIO_KIT }}>
      const el = (id) => document.getElementById(id);

      const getPeopleForModule =
        PROPORTIONS_FACTORS.peopleForModule.modules /
        PROPORTIONS_FACTORS.peopleForModule.people;

      function getNumberModuleAByPercent(people, percentModulesA) {
        return (people * getPeopleForModule * percentModulesA) / 100;
      }

      function getCostModulesA(people, percentModulesA) {
        return (
          getNumberModuleAByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleA.costEur
        );
      }

      function getNumberModuleBByPercent(people, percentModulesA) {
        return (people * getPeopleForModule * (100 - percentModulesA)) / 100;
      }

      function getCostModulesB(people, percentModulesA) {
        return (
          getNumberModuleBByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleB.costEur
        );
      }

      function getTotalCost(people, percentModulesA) {
        return (
          getCostModulesA(people, percentModulesA) +
          getCostModulesB(people, percentModulesA)
        );
      }

      function formatEur(val) {
        return `${Math.round(val).toLocaleString("ca-ES")} €`;
      }

      function formatNum(val) {
        return Number.isInteger(val) ? String(val) : val.toFixed(1);
      }

      function renderCost() {
        const people = Math.max(0, Number(el("personasAfectadas").value) || 0);
        const budget = Math.max(
          0,
          Number(el("presupuestoTotalEur").value) || 0,
        );
        const percentA = Math.min(
          100,
          Math.max(0, Number(el("percentModulesA").value) || 0),
        );
        const percentB = 100 - percentA;

        el("percentModulesAVal").textContent = String(percentA);
        el("hintPctA").textContent = `${percentA}%`;
        el("hintPctB").textContent = `${percentB}%`;

        const modulesA = getNumberModuleAByPercent(people, percentA);
        const modulesB = getNumberModuleBByPercent(people, percentA);
        const costA = getCostModulesA(people, percentA);
        const costB = getCostModulesB(people, percentA);
        const totalCost = getTotalCost(people, percentA);

        const overBudget = totalCost > budget;
        el("budgetBanner").className =
          `banner ${overBudget ? "banner-no_arriba" : "banner-viable"}`;
        el("budgetBadge").className =
          `badge ${overBudget ? "badge-no_arriba" : "badge-viable"}`;
        el("budgetBadge").textContent = overBudget
          ? "Supera el pressupost"
          : "Dins del pressupost";
        el("budgetHeadline").textContent = overBudget
          ? `Excedeix en ${formatEur(totalCost - budget)}`
          : `Queden lliures ${formatEur(budget - totalCost)}`;
        el("budgetDetail").textContent = overBudget
          ? `El cost calculat (${formatEur(totalCost)}) supera el pressupost de ${formatEur(budget)}.`
          : `El cost calculat (${formatEur(totalCost)}) s'ajusta al pressupost de ${formatEur(budget)}.`;

        el("totalCostVal").textContent = formatEur(totalCost);
        el("totalCostSub").textContent =
          `${formatNum(modulesA + modulesB)} mòduls totals`;

        el("costAVal").textContent = formatEur(costA);
        el("modulesASub").textContent =
          `${formatNum(modulesA)} mòduls (${percentA}%)`;

        el("costBVal").textContent = formatEur(costB);
        el("modulesBSub").textContent =
          `${formatNum(modulesB)} mòduls (${percentB}%)`;
      }

      function renderKit(escenarioId) {
        const kitKey = SCENARIO_KIT[escenarioId] ?? "calor";
        const kit = KITS[kitKey];
        if (!kit) return;

        const badge = el("kitBadge");
        badge.textContent = kit.badge;
        badge.className = `kit-badge kit-badge-${kit.id}`;

        el("kitTitle").textContent = kit.nom;

        const list = el("kitList");
        list.replaceChildren(
          ...kit.components.map((item) => {
            const li = document.createElement("li");
            li.textContent = item;
            return li;
          }),
        );
      }

      // En triar un cas, s'actualitzen clima, persones, pressupost, % i càlculs
      el("casoId").addEventListener("change", () => {
        const caso = CASES.find((c) => c.id === el("casoId").value);
        if (!caso) return;
        el("escenarioId").value = caso.input.escenarioId;
        el("personasAfectadas").value = caso.input.personasAfectadas;
        el("presupuestoTotalEur").value = caso.input.presupuestoTotalEur;
        el("percentModulesA").value = 100 - caso.input.pctConexionRed;
        renderKit(caso.input.escenarioId);
        renderCost();
      });

      // En canviar el clima manualment, també s'actualitza el kit
      el("escenarioId").addEventListener("change", () => {
        renderKit(el("escenarioId").value);
      });

      el("personasAfectadas").addEventListener("input", renderCost);
      el("presupuestoTotalEur").addEventListener("input", renderCost);
      el("percentModulesA").addEventListener("input", renderCost);
    </script>
  </body>
</html>
