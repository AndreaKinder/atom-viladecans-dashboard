---
import "../styles/index.css";
import {
  getBudgetUsage,
  getCases,
  getCo2ModulesA,
  getCo2ModulesB,
  getCo2PerPerson,
  getCostModulesA,
  getCostModulesB,
  getCostPerPerson,
  getDaysModulesA,
  getDaysModulesB,
  getKitForScenario,
  getModuleMixFromRedPct,
  getNumberModuleAByPercent,
  getNumberModuleBByPercent,
  getStockCoverage,
  getTotalCo2,
  getTotalCost,
  getTotalDays,
  inputLabels,
  KITS,
  PROPORTIONS_FACTORS,
  SCENARIO_KIT,
  snarioLabels,
} from "../lib/desition-engine.js";

const SCENARIO_LABELS = snarioLabels;

// 60 casos d'emergència del dataset
const CASES = getCases();
const defaultCase = CASES.find((c) => c.id === "EM059") ?? CASES[0];
const initialInput = { ...defaultCase.input };
const initialPercentA = getModuleMixFromRedPct(
  initialInput.pctConexionRed,
).percentModulesA;
const initialKit = getKitForScenario(initialInput.escenarioId);
const initialTotalCost = getTotalCost(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialModulesA = getNumberModuleAByPercent(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialModulesB = getNumberModuleBByPercent(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCostA = getCostModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCostB = getCostModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialBudget = initialInput.presupuestoTotalEur;
const initialStayDays = initialInput.duracionEstanciaDias;
const initialMaxDays = initialInput.plazoMaximoDias;
const DEFAULT_STOCK_MODULES = 4;
const initialStock = getStockCoverage(
  initialInput.personasAfectadas,
  DEFAULT_STOCK_MODULES,
);
const initialDaysA = getDaysModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialDaysB = getDaysModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialTotalDays = getTotalDays(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialPersonCost = getCostPerPerson(
  initialInput.personasAfectadas,
  initialPercentA,
  initialStayDays,
);
const initialCo2A = getCo2ModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCo2B = getCo2ModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialTotalCo2 = getTotalCo2(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialPersonCo2 = getCo2PerPerson(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialBudgetUsage = getBudgetUsage(
  initialInput.personasAfectadas,
  initialPercentA,
  initialBudget,
);
const formatEur = (val) =>
  `${Math.round(val).toLocaleString("ca-ES")} €`;
const formatDays = (val) =>
  val.toLocaleString("ca-ES", { maximumFractionDigits: 1 });
const formatCo2T = (val) =>
  `${val.toLocaleString("ca-ES", { maximumFractionDigits: 1 })} t`;
const formatCo2Kg = (val) =>
  `${Math.round(val).toLocaleString("ca-ES")} kg`;
const formatPct = (val) =>
  `${val.toLocaleString("ca-ES", { maximumFractionDigits: 1 })}%`;

function getBannerState(
  people,
  budget,
  totalCost,
  stockPeople,
  stayDays,
  maxDays,
  totalDays,
) {
  if (totalCost > budget) {
    return {
      variant: "no_arriba",
      badge: "Supera el pressupost",
      headline: `Excedeix en ${formatEur(totalCost - budget)}`,
      detail: `El cost calculat (${formatEur(totalCost)}) supera el pressupost de ${formatEur(budget)}. L'estoc desplegat allotja ${stockPeople} de ${people} persones.`,
    };
  }
  if (totalDays > maxDays && stockPeople < people) {
    const missing = people - stockPeople;
    const extraStay =
      totalDays > stayDays ? ` i supera l'estada de ${stayDays} dies` : "";
    return {
      variant: "no_arriba",
      badge: "No arriba a temps",
      headline: `Muntatge (${formatDays(totalDays)} dies) > termini (${maxDays} dies)`,
      detail: `El termini de ${maxDays} dies és més curt que el muntatge (${formatDays(totalDays)} dies)${extraStay} (estada: ${stayDays} dies). L'estoc desplegat allotja ${stockPeople} de ${people} persones; les altres ${missing} tindrien mòdul al dia ${Math.ceil(totalDays)}.`,
    };
  }
  if (totalDays > stayDays && stockPeople < people) {
    const missing = people - stockPeople;
    return {
      variant: "no_arriba",
      badge: "Supera l'estada",
      headline: `Muntatge (${formatDays(totalDays)} dies) > estada (${stayDays} dies)`,
      detail: `El muntatge (${formatDays(totalDays)} dies) supera l'estada de ${stayDays} dies (termini: ${maxDays} dies). L'estoc desplegat allotja ${stockPeople} de ${people} persones; falten ${missing}.`,
    };
  }
  const freeBudget = formatEur(budget - totalCost);
  if (stockPeople < people) {
    const missing = people - stockPeople;
    return {
      variant: "amb_estoc",
      badge: "Cobertura parcial",
      headline:
        stockPeople === 0
          ? `Sense estoc a la zona · falten ${missing} persones`
          : `Estoc per a ${stockPeople} de ${people} persones`,
      detail: `Dins del pressupost (queden lliures ${freeBudget}), termini (${maxDays} dies) i estada (${stayDays} dies). Falten ${missing} persones per allotjar amb nous mòduls.`,
    };
  }
  return {
    variant: "viable",
    badge: "Cobertura completa",
    headline: `Queden lliures ${freeBudget}`,
    detail: `Dins del pressupost (${formatEur(budget)}), termini (${maxDays} dies) i estada (${stayDays} dies). L'estoc desplegat allotja totes les ${people} persones.`,
  };
}

const initialBanner = getBannerState(
  initialInput.personasAfectadas,
  initialBudget,
  initialTotalCost,
  initialStock.stockPeople,
  initialStayDays,
  initialMaxDays,
  initialTotalDays,
);
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Un quadre de comandament per decidir · ATOM Modular</title>
  </head>
  <body>
    <main class="page">
      <h1>Un quadre de comandament per decidir</h1>

      <div class="tabs" role="tablist">
        <button
          id="tabDashboard"
          type="button"
          class="tab-btn is-active"
          role="tab"
          aria-selected="true"
        >
          Quadre de comandament
        </button>
        <button
          id="tabFormulas"
          type="button"
          class="tab-btn"
          role="tab"
          aria-selected="false"
        >
          Fórmules i criteris
        </button>
      </div>

      <div id="panelDashboard" class="layout">
        <aside class="card sidebar">
          <h2>Dades del cas</h2>

          <div class="field">
            <label for="escenarioId">{inputLabels.Clima}</label>
            <select id="escenarioId">
              {
                Object.entries(SCENARIO_LABELS).map(([k, lbl]) => (
                  <option value={k} selected={k === initialInput.escenarioId}>
                    {lbl}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="personasAfectadas">Persones afectades</label>
              <input
                id="personasAfectadas"
                type="number"
                min="0"
                step="1"
                value={initialInput.personasAfectadas}
              />
            </div>

            <div class="field">
              <label for="duracionEstanciaDias">Estada (dies)</label>
              <input
                id="duracionEstanciaDias"
                type="number"
                min="1"
                step="1"
                value={initialStayDays}
              />
            </div>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="plazoMaximoDias">Termini màxim (dies)</label>
              <input
                id="plazoMaximoDias"
                type="number"
                min="1"
                step="1"
                value={initialMaxDays}
              />
            </div>

            <div class="field">
              <label for="stockModulos">Mòduls-refugi a la zona</label>
              <input
                id="stockModulos"
                type="number"
                min="0"
                step="1"
                value={DEFAULT_STOCK_MODULES}
              />
            </div>
          </div>

          <div class="field">
            <label for="presupuestoTotalEur">Pressupost total (€)</label>
            <input
              id="presupuestoTotalEur"
              type="number"
              min="0"
              step="1000"
              value={initialBudget}
            />
          </div>

          <div class="field">
            <label for="percentModulesA">
              Mòduls autosuficients A (<span id="percentModulesAVal">{initialPercentA}</span>%)
            </label>
            <input
              id="percentModulesA"
              type="range"
              min="0"
              max="100"
              step="1"
              value={initialPercentA}
            />
            <div class="hint">
              <span>A (autosuficient): <strong id="hintPctA">{initialPercentA}%</strong></span>
              <span>B (amb xarxa): <strong id="hintPctB">{100 - initialPercentA}%</strong></span>
            </div>
          </div>
        </aside>

        <section>
          <div
            id="budgetBanner"
            class={`banner banner-${initialBanner.variant}`}
          >
            <div>
              <span
                id="budgetBadge"
                class={`badge badge-${initialBanner.variant}`}
              >
                {initialBanner.badge}
              </span>
              <strong id="budgetHeadline">{initialBanner.headline}</strong>
            </div>
            <div id="budgetDetail" class="banner-detail">
              {initialBanner.detail}
            </div>
          </div>

          <div class="kpis">
            <div class="kpi">
              <div class="kpi-label">Cost total estimat</div>
              <div id="totalCostVal" class="kpi-val">
                {formatEur(initialTotalCost)}
              </div>
              <div id="totalCostSub" class="kpi-sub">
                {initialModulesA + initialModulesB} mòduls totals
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Pressupost consumit</div>
              <div id="budgetPctVal" class="kpi-val">
                {formatPct(initialBudgetUsage.usedPct)}
              </div>
              <div class="progress-track">
                <div
                  id="budgetProgressFill"
                  class="progress-fill"
                  style={`width: ${Math.min(100, Math.max(0, initialBudgetUsage.usedPct))}%`}
                ></div>
              </div>
              <div id="budgetRemainingSub" class="kpi-sub">
                {
                  initialBudgetUsage.remainingEur >= 0
                    ? `${formatEur(initialBudgetUsage.remainingEur)} lliures de ${formatEur(initialBudget)}`
                    : `Excedeix en ${formatEur(Math.abs(initialBudgetUsage.remainingEur))}`
                }
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Cost per persona</div>
              <div id="perPersonVal" class="kpi-val">
                {formatEur(initialPersonCost.perPerson)}
              </div>
              <div id="perPersonSub" class="kpi-sub">
                {formatEur(initialPersonCost.perPersonNight)} per persona i nit
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Desplegament (pendent de revisar)</div>
              <div id="totalDaysVal" class="kpi-val">
                {formatDays(initialTotalDays)} dies
              </div>
              <div id="totalDaysSub" class="kpi-sub">
                {
                  `${initialTotalDays > initialMaxDays ? "fora" : "dins"} termini (${initialMaxDays}d) · ${initialTotalDays > initialStayDays ? "fora" : "dins"} estada (${initialStayDays}d)`
                }
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Mòduls A · Autosuficient</div>
              <div id="costAVal" class="kpi-val">{formatEur(initialCostA)}</div>
              <div id="modulesASub" class="kpi-sub">
                {initialModulesA} mòduls ({initialPercentA}%) ·{" "}
                {formatDays(initialDaysA)} dies · {formatCo2T(initialCo2A)} CO₂
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Mòduls B · Amb xarxa</div>
              <div id="costBVal" class="kpi-val">{formatEur(initialCostB)}</div>
              <div id="modulesBSub" class="kpi-sub">
                {initialModulesB} mòduls ({100 - initialPercentA}%) ·{" "}
                {formatDays(initialDaysB)} dies · {formatCo2T(initialCo2B)} CO₂
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">CO₂ incorporat</div>
              <div id="totalCo2Val" class="kpi-val">
                {formatCo2T(initialTotalCo2)} CO₂
              </div>
              <div id="perPersonCo2Sub" class="kpi-sub">
                {formatCo2Kg(initialPersonCo2.perPersonKg)} CO₂ per persona
              </div>
            </div>
          </div>

          <div class="card">
            <div class="kit-header">
              <span
                id="kitBadge"
                class={`kit-badge kit-badge-${initialKit.id}`}
              >
                {initialKit.badge}
              </span>
              <div>
                <div id="kitTitle" class="section-title">{initialKit.nom}</div>
                <div id="kitSubtitle" class="ab-sub">{initialKit.subtitol}</div>
              </div>
            </div>

            <div id="kitKpis" class="kit-kpis">
              {
                initialKit.kpis.map((kpi) => (
                  <div class={`kit-kpi kit-kpi-${initialKit.id}`}>
                    <div class="kit-kpi-val">{kpi.val}</div>
                    <div class="kit-kpi-txt">{kpi.txt}</div>
                  </div>
                ))
              }
            </div>

            <ul id="kitList" class="kit-list">
              {initialKit.components.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>
      </div>

      <section id="panelFormulas" hidden>
        <div class="card">
          <div class="section-title">
            Com funciona el càlcul (explicat pas a pas)
          </div>
          <ul class="kit-list">
            <li>
              <strong>1. Quants mòduls calen?</strong> Cada mòdul allotja{" "}
              <strong>4 persones</strong>. Es calcula el total de mòduls i es
              reparteix segons el percentatge triat entre{" "}
              <strong>Mòduls A (autosuficients)</strong> i{" "}
              <strong>Mòduls B (connectats a la xarxa)</strong>:
              <div class="formula-box">
                Mòduls totals = Persones afectades ÷ 4<br />
                Mòduls A = Mòduls totals × (% A ÷ 100)<br />
                Mòduls B = Mòduls totals × ((100 − % A) ÷ 100)
              </div>
            </li>
            <li>
              <strong>2. Quant costa el desplegament?</strong> Cada mòdul A
              costa <strong>33.530 €</strong> i cada mòdul B costa{" "}
              <strong>27.400 €</strong> (fabricat i instal·lat):
              <div class="formula-box">
                Cost total = (Mòduls A × 33.530 €) + (Mòduls B × 27.400 €)<br />
                % del pressupost = (Cost total ÷ Pressupost disponible) × 100<br />
                Pressupost lliure = Pressupost disponible − Cost total<br />
                Cost per persona = Cost total ÷ Persones afectades<br />
                Cost per persona i nit = Cost per persona ÷ Dies d'estada{" "}
                <em>(pendent de revisar)</em>
              </div>
            </li>
            <li>
              <strong>
                3. Quants dies es triga a muntar? (pendent de revisar)
              </strong>{" "}
              Un mòdul A requereix <strong>3,6 dies</strong> i un mòdul B
              requereix <strong>3,1 dies</strong>, amb{" "}
              <strong>10 equips treballant en paral·lel</strong>:
              <div class="formula-box">
                Dies Mòduls A = (Mòduls A × 3,6 dies) ÷ 10 equips{" "}
                <em>(pendent de revisar)</em>
                <br />
                Dies Mòduls B = (Mòduls B × 3,1 dies) ÷ 10 equips{" "}
                <em>(pendent de revisar)</em>
                <br />
                Dies totals de desplegament = Dies Mòduls A + Dies Mòduls B{" "}
                <em>(pendent de revisar)</em>
              </div>
            </li>
            <li>
              <strong>4. Què cobreixen els mòduls-refugi a la zona?</strong>{" "}
              Cada mòdul ja disponible sobre el terreny allotja immediatament{" "}
              <strong>4 persones</strong> (fins a cobrir el total d'afectats):
              <div class="formula-box">
                Places immediates a la zona = Mòduls-refugi a la zona × 4<br />
                Persones pendents de nou mòdul = Persones afectades − Places
                immediates cobertes
              </div>
            </li>
            <li>
              <strong>5. Com es decideix l'avís superior (el semàfor)?</strong>
              <ul class="kit-list">
                <li>
                  <strong>Vermell (Supera el pressupost):</strong> Cost total
                  &gt; Pressupost disponible.
                </li>
                <li>
                  <strong>
                    Vermell (No arriba a temps) (pendent de revisar):
                  </strong>{" "}
                  Dies totals de desplegament &gt; Termini màxim i encara queden
                  persones pendents de mòdul.
                </li>
                <li>
                  <strong>
                    Vermell (Supera l'estada) (pendent de revisar):
                  </strong>{" "}
                  Dies totals de desplegament &gt; Dies d'estada i encara queden
                  persones pendents de mòdul.
                </li>
                <li>
                  <strong>Ambre (Cobertura parcial):</strong> Cost total ≤
                  Pressupost i Dies totals ≤ Termini i Estada, però les places
                  immediates a la zona són menors que les persones afectades.
                </li>
                <li>
                  <strong>Verd (Cobertura completa):</strong> Cost total ≤
                  Pressupost, Dies totals ≤ Termini i Estada, i les places
                  immediates a la zona cobreixen totes les persones afectades.
                </li>
              </ul>
            </li>
            <li>
              <strong>6. Quin kit climàtic es tria?</strong> Tots els mòduls
              comparteixen el mateix xassís de fusta de 22 m², i segons el clima
              s'equipa el <strong>Kit Calor</strong> (onada de calor costanera,
              d'interior o post-tempesta humida; estalvi de refrigeració del{" "}
              <strong>−20 %</strong> i confort tèrmic a{" "}
              <strong>25,6 °C · 55 % humitat</strong>) o el{" "}
              <strong>Kit Fred</strong> (fred continental; demanda de
              calefacció de <strong>0 kWh a 22,6 °C</strong>).
            </li>
            <li>
              <strong>7. CO₂ incorporat (total i per persona):</strong> Cada
              mòdul A incorpora <strong>13,3 t</strong> de CO₂ i cada mòdul B
              incorpora <strong>11,5 t</strong>:
              <div class="formula-box">
                CO₂ total (t) = (Mòduls A × 13,3 t) + (Mòduls B × 11,5 t)<br />
                CO₂ per persona (kg) = (CO₂ total × 1.000) ÷ Persones afectades
              </div>
            </li>
          </ul>
        </div>

        <div class="card" style="margin-top: 1rem;">
          <div class="section-title">
            Càlculs i seccions pendents d'implementar
          </div>
          <ul class="kit-list">
            <li>
              <strong>
                1. Barra visual de repartiment i fitxes dels mòduls A i B
              </strong>{" "}
              <em>(pendent)</em>: Barra apilada amb la proporció entre mòduls A
              i B, i targetes inferiors amb els valors unitaris de cada mòdul
              (cost, dies de muntatge i CO₂ incorporat).
            </li>
            <li>
              <strong>2. Accés de camió i prioritat del cas</strong>{" "}
              <em>(pendent)</em>: Camps del dataset per filtrar o condicionar el
              desplegament segons l'accés logístic (normal o limitat) i el
              requisit prioritari (rapidesa, confort, cost, emissions o
              autosuficiència).
            </li>
          </ul>
        </div>
      </section>
    </main>

    <script define:vars={{ KITS, PROPORTIONS_FACTORS, SCENARIO_KIT }}>
      const el = (id) => document.getElementById(id);

      const getPeopleForModule =
        PROPORTIONS_FACTORS.peopleForModule.modules /
        PROPORTIONS_FACTORS.peopleForModule.people;

      function getNumberModuleAByPercent(people, percentModulesA) {
        return (people * getPeopleForModule * percentModulesA) / 100;
      }

      function getCostModulesA(people, percentModulesA) {
        return (
          getNumberModuleAByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleA.costEur
        );
      }

      function getNumberModuleBByPercent(people, percentModulesA) {
        return (people * getPeopleForModule * (100 - percentModulesA)) / 100;
      }

      function getCostModulesB(people, percentModulesA) {
        return (
          getNumberModuleBByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleB.costEur
        );
      }

      function getTotalCost(people, percentModulesA) {
        return (
          getCostModulesA(people, percentModulesA) +
          getCostModulesB(people, percentModulesA)
        );
      }

      function getKDaysModules(daysForModule) {
        return getPeopleForModule * daysForModule;
      }

      function getDaysModulesA(people, percentModulesA) {
        return (
          (people *
            getKDaysModules(PROPORTIONS_FACTORS.moduleA.assemblyDays) *
            percentModulesA) /
          100 /
          PROPORTIONS_FACTORS.common.parallelTeams
        );
      }

      function getDaysModulesB(people, percentModulesA) {
        return (
          (people *
            getKDaysModules(PROPORTIONS_FACTORS.moduleB.assemblyDays) *
            (100 - percentModulesA)) /
          100 /
          PROPORTIONS_FACTORS.common.parallelTeams
        );
      }

      function getTotalDays(people, percentModulesA) {
        return (
          getDaysModulesA(people, percentModulesA) +
          getDaysModulesB(people, percentModulesA)
        );
      }

      function getCo2ModulesA(people, percentModulesA) {
        return (
          getNumberModuleAByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleA.co2T
        );
      }

      function getCo2ModulesB(people, percentModulesA) {
        return (
          getNumberModuleBByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleB.co2T
        );
      }

      function getTotalCo2(people, percentModulesA) {
        return (
          getCo2ModulesA(people, percentModulesA) +
          getCo2ModulesB(people, percentModulesA)
        );
      }

      function formatEur(val) {
        return `${Math.round(val).toLocaleString("ca-ES")} €`;
      }

      function formatNum(val) {
        return Number.isInteger(val) ? String(val) : val.toFixed(1);
      }

      function formatDays(val) {
        return val.toLocaleString("ca-ES", { maximumFractionDigits: 1 });
      }

      function formatCo2T(val) {
        return `${val.toLocaleString("ca-ES", { maximumFractionDigits: 1 })} t`;
      }

      function formatCo2Kg(val) {
        return `${Math.round(val).toLocaleString("ca-ES")} kg`;
      }

      function formatPct(val) {
        return `${val.toLocaleString("ca-ES", { maximumFractionDigits: 1 })}%`;
      }

      function renderBanner(
        people,
        budget,
        totalCost,
        stockPeople,
        stayDays,
        maxDays,
        totalDays,
      ) {
        let variant = "viable";
        let badge = "Cobertura completa";
        let headline = `Queden lliures ${formatEur(budget - totalCost)}`;
        let detail = `Dins del pressupost (${formatEur(budget)}), termini (${maxDays} dies) i estada (${stayDays} dies). L'estoc desplegat allotja totes les ${people} persones.`;

        if (totalCost > budget) {
          variant = "no_arriba";
          badge = "Supera el pressupost";
          headline = `Excedeix en ${formatEur(totalCost - budget)}`;
          detail = `El cost calculat (${formatEur(totalCost)}) supera el pressupost de ${formatEur(budget)}. L'estoc desplegat allotja ${stockPeople} de ${people} persones.`;
        } else if (totalDays > maxDays && stockPeople < people) {
          const missing = people - stockPeople;
          const extraStay =
            totalDays > stayDays
              ? ` i supera l'estada de ${stayDays} dies`
              : "";
          variant = "no_arriba";
          badge = "No arriba a temps";
          headline = `Muntatge (${formatDays(totalDays)} dies) > termini (${maxDays} dies)`;
          detail = `El termini de ${maxDays} dies és més curt que el muntatge (${formatDays(totalDays)} dies)${extraStay} (estada: ${stayDays} dies). L'estoc desplegat allotja ${stockPeople} de ${people} persones; les altres ${missing} tindrien mòdul al dia ${Math.ceil(totalDays)}.`;
        } else if (totalDays > stayDays && stockPeople < people) {
          const missing = people - stockPeople;
          variant = "no_arriba";
          badge = "Supera l'estada";
          headline = `Muntatge (${formatDays(totalDays)} dies) > estada (${stayDays} dies)`;
          detail = `El muntatge (${formatDays(totalDays)} dies) supera l'estada de ${stayDays} dies (termini: ${maxDays} dies). L'estoc desplegat allotja ${stockPeople} de ${people} persones; falten ${missing}.`;
        } else if (stockPeople < people) {
          const missing = people - stockPeople;
          variant = "amb_estoc";
          badge = "Cobertura parcial";
          headline =
            stockPeople === 0
              ? `Sense estoc a la zona · falten ${missing} persones`
              : `Estoc per a ${stockPeople} de ${people} persones`;
          detail = `Dins del pressupost (queden lliures ${formatEur(budget - totalCost)}), termini (${maxDays} dies) i estada (${stayDays} dies). Falten ${missing} persones per allotjar amb nous mòduls.`;
        }

        el("budgetBanner").className = `banner banner-${variant}`;
        el("budgetBadge").className = `badge badge-${variant}`;
        el("budgetBadge").textContent = badge;
        el("budgetHeadline").textContent = headline;
        el("budgetDetail").textContent = detail;
      }

      function renderCost() {
        const people = Math.max(0, Number(el("personasAfectadas").value) || 0);
        const stayDays = Math.max(
          1,
          Number(el("duracionEstanciaDias").value) || 1,
        );
        const maxDays = Math.max(
          1,
          Number(el("plazoMaximoDias").value) || 1,
        );
        const budget = Math.max(
          0,
          Number(el("presupuestoTotalEur").value) || 0,
        );
        const stockModules = Math.max(
          0,
          Number(el("stockModulos").value) || 0,
        );
        const stockPeople = Math.min(
          people,
          stockModules * PROPORTIONS_FACTORS.common.capacity,
        );
        const percentA = Math.min(
          100,
          Math.max(0, Number(el("percentModulesA").value) || 0),
        );
        const percentB = 100 - percentA;

        el("percentModulesAVal").textContent = String(percentA);
        el("hintPctA").textContent = `${percentA}%`;
        el("hintPctB").textContent = `${percentB}%`;

        const modulesA = getNumberModuleAByPercent(people, percentA);
        const modulesB = getNumberModuleBByPercent(people, percentA);
        const costA = getCostModulesA(people, percentA);
        const costB = getCostModulesB(people, percentA);
        const totalCost = getTotalCost(people, percentA);
        const daysA = getDaysModulesA(people, percentA);
        const daysB = getDaysModulesB(people, percentA);
        const totalDays = getTotalDays(people, percentA);
        const co2A = getCo2ModulesA(people, percentA);
        const co2B = getCo2ModulesB(people, percentA);
        const totalCo2 = getTotalCo2(people, percentA);
        const perPersonCo2Kg = people > 0 ? (totalCo2 * 1000) / people : 0;
        const perPerson = people > 0 ? totalCost / people : 0;
        const perPersonNight = perPerson / stayDays;
        const usedPct = budget > 0 ? (totalCost / budget) * 100 : 0;
        const remainingEur = budget - totalCost;

        renderBanner(
          people,
          budget,
          totalCost,
          stockPeople,
          stayDays,
          maxDays,
          totalDays,
        );

        el("totalCostVal").textContent = formatEur(totalCost);
        el("totalCostSub").textContent =
          `${formatNum(modulesA + modulesB)} mòduls totals`;

        el("budgetPctVal").textContent = formatPct(usedPct);
        el("budgetProgressFill").style.width =
          `${Math.min(100, Math.max(0, usedPct))}%`;
        el("budgetRemainingSub").textContent =
          remainingEur >= 0
            ? `${formatEur(remainingEur)} lliures de ${formatEur(budget)}`
            : `Excedeix en ${formatEur(Math.abs(remainingEur))}`;

        el("perPersonVal").textContent = formatEur(perPerson);
        el("perPersonSub").textContent =
          `${formatEur(perPersonNight)} per persona i nit`;

        el("totalDaysVal").textContent = `${formatDays(totalDays)} dies`;
        el("totalDaysSub").textContent =
          `${totalDays > maxDays ? "fora" : "dins"} termini (${maxDays}d) · ${totalDays > stayDays ? "fora" : "dins"} estada (${stayDays}d)`;

        el("costAVal").textContent = formatEur(costA);
        el("modulesASub").textContent =
          `${formatNum(modulesA)} mòduls (${percentA}%) · ${formatDays(daysA)} dies · ${formatCo2T(co2A)} CO₂`;

        el("costBVal").textContent = formatEur(costB);
        el("modulesBSub").textContent =
          `${formatNum(modulesB)} mòduls (${percentB}%) · ${formatDays(daysB)} dies · ${formatCo2T(co2B)} CO₂`;

        el("totalCo2Val").textContent = `${formatCo2T(totalCo2)} CO₂`;
        el("perPersonCo2Sub").textContent =
          `${formatCo2Kg(perPersonCo2Kg)} CO₂ per persona`;
      }

      function renderKit(escenarioId) {
        const kitKey = SCENARIO_KIT[escenarioId] ?? "calor";
        const kit = KITS[kitKey];
        if (!kit) return;

        const badge = el("kitBadge");
        badge.textContent = kit.badge;
        badge.className = `kit-badge kit-badge-${kit.id}`;

        el("kitTitle").textContent = kit.nom;
        el("kitSubtitle").textContent = kit.subtitol;

        const kpis = el("kitKpis");
        kpis.replaceChildren(
          ...kit.kpis.map((kpi) => {
            const box = document.createElement("div");
            box.className = `kit-kpi kit-kpi-${kit.id}`;
            const val = document.createElement("div");
            val.className = "kit-kpi-val";
            val.textContent = kpi.val;
            const txt = document.createElement("div");
            txt.className = "kit-kpi-txt";
            txt.textContent = kpi.txt;
            box.append(val, txt);
            return box;
          }),
        );

        const list = el("kitList");
        list.replaceChildren(
          ...kit.components.map((item) => {
            const li = document.createElement("li");
            li.textContent = item;
            return li;
          }),
        );
      }

      // En canviar el clima manualment, també s'actualitza el kit
      el("escenarioId").addEventListener("change", () => {
        renderKit(el("escenarioId").value);
      });

      el("personasAfectadas").addEventListener("input", renderCost);
      el("duracionEstanciaDias").addEventListener("input", renderCost);
      el("plazoMaximoDias").addEventListener("input", renderCost);
      el("presupuestoTotalEur").addEventListener("input", renderCost);
      el("stockModulos").addEventListener("input", renderCost);
      el("percentModulesA").addEventListener("input", renderCost);

      function switchTab(activeTab) {
        const isDashboard = activeTab === "dashboard";
        el("panelDashboard").hidden = !isDashboard;
        el("panelFormulas").hidden = isDashboard;
        el("tabDashboard").classList.toggle("is-active", isDashboard);
        el("tabFormulas").classList.toggle("is-active", !isDashboard);
        el("tabDashboard").setAttribute("aria-selected", String(isDashboard));
        el("tabFormulas").setAttribute("aria-selected", String(!isDashboard));
      }

      el("tabDashboard").addEventListener("click", () =>
        switchTab("dashboard"),
      );
      el("tabFormulas").addEventListener("click", () => switchTab("formulas"));
    </script>
  </body>
</html>
