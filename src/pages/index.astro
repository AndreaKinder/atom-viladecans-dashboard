---
import "../styles/index.css";
import SensorPlatform from "../components/SensorPlatform.astro";
import {
  getBudgetUsage,
  getCases,
  getCo2ModulesA,
  getCo2ModulesB,
  getCo2PerPerson,
  getCostModulesA,
  getCostModulesB,
  getCostPerPerson,
  getDaysModulesA,
  getDaysModulesB,
  getKitForScenario,
  getModuleMixFromRedPct,
  getNumberModuleAByPercent,
  getNumberModuleBByPercent,
  getStockCoverage,
  getTotalCo2,
  getTotalCost,
  getTotalDays,
  PROPORTIONS_FACTORS,
  SCENARIO_KIT,
  snarioLabels,
} from "../lib/decision-engine.js";

const SCENARIO_LABELS_ES = {
  C01: "Ola de calor costera",
  C02: "Ola de calor interior",
  C03: "Frío continental",
  C04: "Post-tormenta húmeda",
};

const TRUCK_ACCESS_LABELS_ES = {
  si: "Acceso estándar (camión grúa)",
  limitado: "Acceso limitado (vehículo ligero / grúa local)",
};

const PRIORITY_LABELS_ES = {
  rapidez: "Rapidez de despliegue",
  confort: "Confort térmico",
  coste: "Optimización de costes",
  emisiones: "Mínimas emisiones (CO₂)",
  autosuficiencia: "Autosuficiencia energética",
};

const KIT_UI_ES = {
  calor: {
    id: "calor",
    badge: "C",
    nom: "Heat Kit (Calor)",
    subtitol: "Costa cálida · interior seco · calor húmedo",
    kpis: [
      { val: "−20%", txt: "Ahorro en demanda de refrigeración" },
      { val: "25,6 °C · 55%", txt: "Confort térmico interior y humedad" },
    ],
    components: [
      "Cubierta y fachada de color claro (absortancia 0,2)",
      "Vidrio de control solar",
      "Persiana exterior domotizada activada por radiación solar",
      "Recuperador entálpico (75% calor, 65% humedad)",
    ],
  },
  fred: {
    id: "fred",
    badge: "F",
    nom: "Cold Kit (Frío)",
    subtitol: "Ola de frío continental",
    kpis: [{ val: "0 kWh", txt: "Demanda de calefacción a 22,6 °C" }],
    components: [
      "Vidrio bajo emisivo (g 0,50) para ganancia solar pasiva",
      "Persiana exterior: abierta de día, cerrada de noche",
      "Recuperador de calor en modo invierno",
      "Bomba de calor de respaldo, idéntica en ambos kits",
    ],
  },
};

const MODULE_UI_ES = {
  A: {
    name: "Autosuficiente (Off-Grid)",
    description: "14 m² paneles solares + batería 10 kWh",
  },
  B: {
    name: "Conectado a Red",
    description: "Conexión directa a red eléctrica existente",
  },
};

const SCENARIO_LABELS = Object.fromEntries(
  Object.keys(snarioLabels).map((k) => [
    k,
    SCENARIO_LABELS_ES[k] ?? snarioLabels[k],
  ]),
);

// 60 casos de emergencia del dataset
const CASES = getCases();
const defaultCase = CASES.find((c) => c.id === "EM059") ?? CASES[0];
const initialInput = { ...defaultCase.input };
const initialPercentA = getModuleMixFromRedPct(
  initialInput.pctConexionRed,
).percentModulesA;
const initialKitKey = SCENARIO_KIT[initialInput.escenarioId] ?? "calor";
const initialKit = KIT_UI_ES[initialKitKey] ?? getKitForScenario(initialInput.escenarioId);
const initialTotalCost = getTotalCost(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialModulesA = getNumberModuleAByPercent(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialModulesB = getNumberModuleBByPercent(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCostA = getCostModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCostB = getCostModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialBudget = initialInput.presupuestoTotalEur;
const initialStayDays = initialInput.duracionEstanciaDias;
const initialMaxDays = initialInput.plazoMaximoDias;
const DEFAULT_STOCK_MODULES = 4;
const initialStock = getStockCoverage(
  initialInput.personasAfectadas,
  DEFAULT_STOCK_MODULES,
);
const initialDaysA = getDaysModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialDaysB = getDaysModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialTotalDays = getTotalDays(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialPersonCost = getCostPerPerson(
  initialInput.personasAfectadas,
  initialPercentA,
  initialStayDays,
);
const initialCo2A = getCo2ModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCo2B = getCo2ModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialTotalCo2 = getTotalCo2(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialPersonCo2 = getCo2PerPerson(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialBudgetUsage = getBudgetUsage(
  initialInput.personasAfectadas,
  initialPercentA,
  initialBudget,
);
const NOTICE_PRIORITY_GUIDANCE_ES = {
  rapidez:
    "Prioridad rapidez: despliega primero los módulos en stock in situ y prioriza el Módulo B (3,1 días/módulo frente a 3,6 días del Módulo A).",
  confort:
    "Prioridad confort térmico: chasis con 24 cm de aislamiento de celulosa (U 0,162) combinado con el Kit Climático activo.",
  coste:
    "Prioridad coste: maximiza el % de unidades Módulo B conectadas a red (27.400 €/módulo frente a 33.530 € del Módulo A).",
  emisiones:
    "Prioridad emisiones: el Módulo B reduce la huella a 11,5 t CO₂/módulo (frente a 13,3 t CO₂ del Módulo A con batería y fotovoltaica).",
  autosuficiencia:
    "Prioridad autosuficiencia: prioriza el Módulo A (14 m² de paneles solares + batería 10 kWh) para operación aislada de red.",
};

const initialNotices = [
  initialInput.accesoCamion === "limitado"
    ? {
        variant: "danger",
        title: "Acceso logístico limitado",
        text: "El tráiler pesado no puede acceder: requiere transporte paletizado de paneles desmontados con vehículo ligero o grúa local.",
      }
    : {
        variant: "info",
        title: "Acceso logístico estándar",
        text: "Acceso directo con camión grúa estándar hasta el punto de montaje.",
      },
  {
    variant: "info",
    title: `Criterio prioritario · ${PRIORITY_LABELS_ES[initialInput.requisitoPrioritario] ?? PRIORITY_LABELS_ES.confort}`,
    text:
      NOTICE_PRIORITY_GUIDANCE_ES[initialInput.requisitoPrioritario] ??
      NOTICE_PRIORITY_GUIDANCE_ES.confort,
  },
];

const formatEur = (val) =>
  `${Math.round(val).toLocaleString("es-ES")} €`;
const formatDays = (val) =>
  val.toLocaleString("es-ES", { maximumFractionDigits: 1 });
const formatCo2T = (val) =>
  `${val.toLocaleString("es-ES", { maximumFractionDigits: 1 })} t`;
const formatCo2Kg = (val) =>
  `${Math.round(val).toLocaleString("es-ES")} kg`;
const formatPct = (val) =>
  `${val.toLocaleString("es-ES", { maximumFractionDigits: 1 })}%`;

function getBannerState(
  people,
  budget,
  totalCost,
  stockPeople,
  stayDays,
  maxDays,
  totalDays,
) {
  if (totalCost > budget) {
    return {
      variant: "no_arriba",
      badge: "Fuera de presupuesto",
      headline: `Excede en ${formatEur(totalCost - budget)}`,
      detail: `El coste calculado (${formatEur(totalCost)}) supera el presupuesto de ${formatEur(budget)}. El stock desplegado aloja a ${stockPeople} de ${people} personas.`,
    };
  }
  if (totalDays > maxDays && stockPeople < people) {
    const missing = people - stockPeople;
    const extraStay =
      totalDays > stayDays ? ` y supera la estancia de ${stayDays} días` : "";
    return {
      variant: "no_arriba",
      badge: "Incumple plazo",
      headline: `Montaje (${formatDays(totalDays)} días) > plazo (${maxDays} días)`,
      detail: `El plazo máximo de ${maxDays} días es inferior al montaje (${formatDays(totalDays)} días)${extraStay} (estancia: ${stayDays} días). El stock aloja a ${stockPeople} de ${people} personas; las ${missing} restantes recibirían módulo el día ${Math.ceil(totalDays)}.`,
    };
  }
  if (totalDays > stayDays && stockPeople < people) {
    const missing = people - stockPeople;
    return {
      variant: "no_arriba",
      badge: "Supera estancia",
      headline: `Montaje (${formatDays(totalDays)} días) > estancia (${stayDays} días)`,
      detail: `El montaje (${formatDays(totalDays)} días) supera la estancia de ${stayDays} días (plazo: ${maxDays} días). El stock aloja a ${stockPeople} de ${people} personas; ${missing} siguen necesitando refugio.`,
    };
  }
  const freeBudget = formatEur(budget - totalCost);
  if (stockPeople < people) {
    const missing = people - stockPeople;
    return {
      variant: "amb_estoc",
      badge: "Cobertura parcial",
      headline:
        stockPeople === 0
          ? `Sin stock in situ · ${missing} personas pendientes`
          : `Stock in situ para ${stockPeople} de ${people} personas`,
      detail: `Dentro de presupuesto (${freeBudget} disponibles), plazo (${maxDays} días) y estancia (${stayDays} días). ${missing} personas requieren módulos nuevos.`,
    };
  }
  return {
    variant: "viable",
    badge: "Cobertura total",
    headline: `${freeBudget} disponibles`,
    detail: `Dentro de presupuesto (${formatEur(budget)}), plazo (${maxDays} días) y estancia (${stayDays} días). El stock desplegado cubre a las ${people} personas.`,
  };
}

const initialBanner = getBannerState(
  initialInput.personasAfectadas,
  initialBudget,
  initialTotalCost,
  initialStock.stockPeople,
  initialStayDays,
  initialMaxDays,
  initialTotalDays,
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Planificador de Despliegue · ATOM Modular</title>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <div>
          <div class="eyebrow">ATOM Modular · Missió Clima Viladecans 2030</div>
          <h1>Planificador de Despliegue de Emergencia</h1>
        </div>

        <div class="tabs" role="tablist" aria-label="Vistas del dashboard">
          <button
            id="tabDashboard"
            type="button"
            class="tab-btn is-active"
            role="tab"
            aria-selected="true"
            aria-controls="panelDashboard"
          >
            Planificación
          </button>
          <button
            id="tabSensors"
            type="button"
            class="tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="panelSensors"
          >
            Plataforma de Sensores
          </button>
        </div>
      </header>

      <div id="panelDashboard" class="layout" role="tabpanel" aria-labelledby="tabDashboard">
        <aside class="card sidebar" id="sidebarCard">
          <div class="sidebar-head">
            <h2>Parámetros del caso</h2>
            <button
              id="toggleSidebarBtn"
              type="button"
              class="sidebar-toggle"
              aria-expanded="true"
              aria-controls="sidebarFields"
            >
              Ocultar
            </button>
          </div>

          <div id="sidebarFields" class="sidebar-fields">
            <div class="field">
              <label for="caseSelector">Caso de emergencia (Dataset CON-E1)</label>
              <select id="caseSelector">
                <option value="custom">Personalizado (edición manual)</option>
                {
                  CASES.map((c) => (
                    <option value={c.id} selected={c.id === defaultCase.id}>
                      {c.id} · {SCENARIO_LABELS[c.input.escenarioId] ?? c.input.escenarioId} ({c.input.personasAfectadas} pers.)
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="field">
              <label for="escenarioId">Escenario climático</label>
              <select id="escenarioId">
                {
                  Object.entries(SCENARIO_LABELS).map(([k, lbl]) => (
                    <option value={k} selected={k === initialInput.escenarioId}>
                      {lbl}
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="grid-2">
              <div class="field">
                <label for="personasAfectadas">Personas afectadas</label>
                <input
                  id="personasAfectadas"
                  type="number"
                  min="0"
                  step="1"
                  value={initialInput.personasAfectadas}
                />
              </div>

              <div class="field">
                <label for="duracionEstanciaDias">Estancia (días)</label>
                <input
                  id="duracionEstanciaDias"
                  type="number"
                  min="1"
                  step="1"
                  value={initialStayDays}
                />
              </div>
            </div>

            <div class="grid-2">
              <div class="field">
                <label for="plazoMaximoDias">Plazo máx. (días)</label>
                <input
                  id="plazoMaximoDias"
                  type="number"
                  min="1"
                  step="1"
                  value={initialMaxDays}
                />
              </div>

              <div class="field">
                <label for="stockModulos">Módulos en stock</label>
                <input
                  id="stockModulos"
                  type="number"
                  min="0"
                  step="1"
                  value={DEFAULT_STOCK_MODULES}
                />
              </div>
            </div>

            <div class="field">
              <label for="presupuestoTotalEur">Presupuesto disponible (€)</label>
              <input
                id="presupuestoTotalEur"
                type="number"
                min="0"
                step="1000"
                value={initialBudget}
              />
            </div>

            <div class="field">
              <label for="accesoCamion">Acceso logístico</label>
              <select id="accesoCamion">
                {
                  Object.entries(TRUCK_ACCESS_LABELS_ES).map(([k, lbl]) => (
                    <option value={k} selected={k === initialInput.accesoCamion}>
                      {lbl}
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="field">
              <label for="requisitoPrioritario">Criterio prioritario</label>
              <select id="requisitoPrioritario">
                {
                  Object.entries(PRIORITY_LABELS_ES).map(([k, lbl]) => (
                    <option
                      value={k}
                      selected={k === initialInput.requisitoPrioritario}
                    >
                      {lbl}
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="field">
              <label for="percentModulesA">
                Módulos A autosuficientes (<span id="percentModulesAVal">{initialPercentA}</span>%)
              </label>
              <input
                id="percentModulesA"
                type="range"
                min="0"
                max="100"
                step="1"
                value={initialPercentA}
              />
              <div class="hint">
                <span>A (autosuficiente): <strong id="hintPctA">{initialPercentA}%</strong></span>
                <span>B (con red): <strong id="hintPctB">{100 - initialPercentA}%</strong></span>
              </div>
            </div>
          </div>
        </aside>

        <section>
          <div
            id="budgetBanner"
            class={`banner banner-${initialBanner.variant}`}
            role="status"
            aria-live="polite"
          >
            <div>
              <span
                id="budgetBadge"
                class={`badge badge-${initialBanner.variant}`}
              >
                {initialBanner.badge}
              </span>
              <strong id="budgetHeadline">{initialBanner.headline}</strong>
            </div>
            <div id="budgetDetail" class="banner-detail">
              {initialBanner.detail}
            </div>
          </div>

          <div class="kpis">
            <div class="kpi">
              <div class="kpi-label">Coste total estimado</div>
              <div id="totalCostVal" class="kpi-val">
                {formatEur(initialTotalCost)}
              </div>
              <div id="totalCostSub" class="kpi-sub">
                {initialModulesA + initialModulesB} módulos totales ({initialInput.personasAfectadas} pers.)
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Presupuesto consumido</div>
              <div id="budgetPctVal" class="kpi-val">
                {
                  initialBudgetUsage.usedPct === null
                    ? "Sin presupuesto"
                    : formatPct(initialBudgetUsage.usedPct)
                }
              </div>
              <div class="progress-track">
                <div
                  id="budgetProgressFill"
                  class={`progress-fill ${initialBudgetUsage.isOverBudget ? "is-over-budget" : ""}`}
                  style={`width: ${initialBudgetUsage.usedPct === null ? 100 : Math.min(100, Math.max(0, initialBudgetUsage.usedPct))}%`}
                ></div>
              </div>
              <div id="budgetRemainingSub" class="kpi-sub">
                {
                  initialBudgetUsage.remainingEur >= 0
                    ? `${formatEur(initialBudgetUsage.remainingEur)} libres de ${formatEur(initialBudget)}`
                    : `Excede en ${formatEur(Math.abs(initialBudgetUsage.remainingEur))}`
                }
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Coste por persona</div>
              <div id="perPersonVal" class="kpi-val">
                {formatEur(initialPersonCost.perPerson)}
              </div>
              <div id="perPersonSub" class="kpi-sub">
                {formatEur(initialPersonCost.perPersonNight)} por persona y noche
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Tiempo de despliegue</div>
              <div id="totalDaysVal" class="kpi-val">
                {formatDays(initialTotalDays)} días
              </div>
              <div id="totalDaysSub" class="kpi-sub">
                {
                  `${initialTotalDays > initialMaxDays ? "fuera de" : "en"} plazo (${initialMaxDays}d) · ${initialTotalDays > initialStayDays ? "supera" : "dentro de"} estancia (${initialStayDays}d)`
                }
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">CO₂ incorporado</div>
              <div id="totalCo2Val" class="kpi-val">
                {formatCo2T(initialTotalCo2)} CO₂
              </div>
              <div id="perPersonCo2Sub" class="kpi-sub">
                {formatCo2Kg(initialPersonCo2.perPersonKg)} CO₂/pers. · −50% vs hormigón
              </div>
            </div>
          </div>

          <div class="ab-grid">
            <div
              id="cardModuleA"
              class={`ab-card ab-card-a ${initialPercentA === 0 ? "is-empty" : ""}`}
            >
              <div class="ab-header">
                <span class="ab-badge ab-badge-a">
                  {PROPORTIONS_FACTORS.moduleA.id}
                </span>
                <div>
                  <div class="ab-title">
                    Módulo {PROPORTIONS_FACTORS.moduleA.id} ·{" "}
                    {MODULE_UI_ES.A.name}
                  </div>
                  <div class="ab-sub">
                    {MODULE_UI_ES.A.description}
                  </div>
                </div>
              </div>
              <div class="ab-rows">
                <div class="ab-row">
                  <div id="modulesAVal" class="ab-val ab-val-a">
                    {initialModulesA} módulos
                  </div>
                  <div id="modulesAPctLbl" class="ab-lbl">
                    {initialPercentA}% del despliegue ·{" "}
                    {PROPORTIONS_FACTORS.common.areaM2} m² (
                    {PROPORTIONS_FACTORS.common.capacity} plazas)
                  </div>
                </div>
                <div class="ab-row">
                  <div id="costAVal" class="ab-val ab-val-a">
                    {formatEur(initialCostA)}
                  </div>
                  <div class="ab-lbl">
                    {formatEur(PROPORTIONS_FACTORS.moduleA.costEur)} por módulo
                  </div>
                </div>
                <div class="ab-row">
                  <div id="daysAVal" class="ab-val ab-val-a">
                    {formatDays(initialDaysA)} días
                  </div>
                  <div class="ab-lbl">
                    {formatDays(PROPORTIONS_FACTORS.moduleA.assemblyDays)} días /
                    módulo ({PROPORTIONS_FACTORS.common.parallelTeams} cuadrillas)
                  </div>
                </div>
                <div class="ab-row">
                  <div id="co2AVal" class="ab-val ab-val-a">
                    {formatCo2T(initialCo2A)} CO₂
                  </div>
                  <div class="ab-lbl">
                    {formatCo2T(PROPORTIONS_FACTORS.moduleA.co2T)} CO₂ por módulo
                  </div>
                </div>
              </div>
            </div>

            <div
              id="cardModuleB"
              class={`ab-card ab-card-b ${initialPercentA === 100 ? "is-empty" : ""}`}
            >
              <div class="ab-header">
                <span class="ab-badge ab-badge-b">
                  {PROPORTIONS_FACTORS.moduleB.id}
                </span>
                <div>
                  <div class="ab-title">
                    Módulo {PROPORTIONS_FACTORS.moduleB.id} ·{" "}
                    {MODULE_UI_ES.B.name}
                  </div>
                  <div class="ab-sub">
                    {MODULE_UI_ES.B.description}
                  </div>
                </div>
              </div>
              <div class="ab-rows">
                <div class="ab-row">
                  <div id="modulesBVal" class="ab-val ab-val-b">
                    {initialModulesB} módulos
                  </div>
                  <div id="modulesBPctLbl" class="ab-lbl">
                    {100 - initialPercentA}% del despliegue ·{" "}
                    {PROPORTIONS_FACTORS.common.areaM2} m² (
                    {PROPORTIONS_FACTORS.common.capacity} plazas)
                  </div>
                </div>
                <div class="ab-row">
                  <div id="costBVal" class="ab-val ab-val-b">
                    {formatEur(initialCostB)}
                  </div>
                  <div class="ab-lbl">
                    {formatEur(PROPORTIONS_FACTORS.moduleB.costEur)} por módulo
                  </div>
                </div>
                <div class="ab-row">
                  <div id="daysBVal" class="ab-val ab-val-b">
                    {formatDays(initialDaysB)} días
                  </div>
                  <div class="ab-lbl">
                    {formatDays(PROPORTIONS_FACTORS.moduleB.assemblyDays)} días /
                    módulo ({PROPORTIONS_FACTORS.common.parallelTeams} cuadrillas)
                  </div>
                </div>
                <div class="ab-row">
                  <div id="co2BVal" class="ab-val ab-val-b">
                    {formatCo2T(initialCo2B)} CO₂
                  </div>
                  <div class="ab-lbl">
                    {formatCo2T(PROPORTIONS_FACTORS.moduleB.co2T)} CO₂ por módulo
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mid-grid">
            <div class="card">
              <div class="section-title">
                Reparto modular y chasis común
              </div>
              <div class="stacked-bar">
                <div
                  id="barA"
                  class="bar-a"
                  style={`width: ${initialPercentA}%`}
                ></div>
                <div
                  id="barB"
                  class="bar-b"
                  style={`width: ${100 - initialPercentA}%`}
                ></div>
              </div>
              <div class="mix-row">
                <span class="dot" style="background: var(--teal);"></span>
                <span>
                  Módulo A (autosuficiente):{" "}
                  <strong id="mixTextA">
                    {initialModulesA} módulos ({initialPercentA}%)
                  </strong>
                </span>
              </div>
              <div class="mix-row">
                <span class="dot" style="background: var(--amber);"></span>
                <span>
                  Módulo B (conectado a red):{" "}
                  <strong id="mixTextB">
                    {initialModulesB} módulos ({100 - initialPercentA}%)
                  </strong>
                </span>
              </div>
              <div class="kpi-sub" style="margin-top: 0.65rem;">
                Chasis común ({PROPORTIONS_FACTORS.common.areaM2} m² ·{" "}
                {PROPORTIONS_FACTORS.common.capacity} plazas): madera laminada, 24 cm de celulosa (U 0,162 W/m²K)
              </div>

              <div id="operationalNotices" style="margin-top: 0.85rem;">
                {
                  initialNotices.map((notice) => (
                    <div class={`aviso aviso-${notice.variant}`}>
                      <strong>{notice.title}:</strong> {notice.text}
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="card">
              <div class="kit-header">
                <span
                  id="kitBadge"
                  class={`kit-badge kit-badge-${initialKit.id}`}
                >
                  {initialKit.badge}
                </span>
                <div>
                  <div id="kitTitle" class="section-title">{initialKit.nom}</div>
                  <div id="kitSubtitle" class="ab-sub">{initialKit.subtitol}</div>
                </div>
              </div>

              <div id="kitKpis" class="kit-kpis">
                {
                  initialKit.kpis.map((kpi) => (
                    <div class={`kit-kpi kit-kpi-${initialKit.id}`}>
                      <div class="kit-kpi-val">{kpi.val}</div>
                      <div class="kit-kpi-txt">{kpi.txt}</div>
                    </div>
                  ))
                }
              </div>

              <ul id="kitList" class="kit-list">
                {initialKit.components.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>
      </div>

      <SensorPlatform />

      <footer class="page-footer">
        <span>Fuente: Dataset CON-E1 · ATOM Modular (60 casos de emergencia)</span>
        <span>Supuestos base: 10 cuadrillas paralelas · 4 plazas / 22 m² por módulo</span>
        <span>Refresco: cálculo determinista en tiempo real</span>
      </footer>
    </main>

    <script>
      import {
        getBudgetUsage,
        getCases,
        getCo2ModulesA,
        getCo2ModulesB,
        getCo2PerPerson,
        getCostModulesA,
        getCostModulesB,
        getCostPerPerson,
        getDaysModulesA,
        getDaysModulesB,
        getModuleMixFromRedPct,
        getNumberModuleAByPercent,
        getNumberModuleBByPercent,
        getStockCoverage,
        getTotalCo2,
        getTotalCost,
        getTotalDays,
        PROPORTIONS_FACTORS,
        SCENARIO_KIT,
      } from "../lib/decision-engine.js";

      const el = (id) => document.getElementById(id);
      const CASES_LIST = getCases();
      const CASES_BY_ID = new Map(CASES_LIST.map((c) => [c.id, c]));

      function formatEur(val) {
        return `${Math.round(val).toLocaleString("es-ES")} €`;
      }

      function formatNum(val) {
        return Number.isInteger(val) ? String(val) : val.toFixed(1).replace(".", ",");
      }

      function formatDays(val) {
        return val.toLocaleString("es-ES", { maximumFractionDigits: 1 });
      }

      function formatCo2T(val) {
        return `${val.toLocaleString("es-ES", { maximumFractionDigits: 1 })} t`;
      }

      function formatCo2Kg(val) {
        return `${Math.round(val).toLocaleString("es-ES")} kg`;
      }

      function formatPct(val) {
        return `${val.toLocaleString("es-ES", { maximumFractionDigits: 1 })}%`;
      }

      function renderBanner(
        people,
        budget,
        totalCost,
        stockPeople,
        stayDays,
        maxDays,
        totalDays,
      ) {
        let variant = "viable";
        let badge = "Cobertura total";
        let headline = `${formatEur(budget - totalCost)} disponibles`;
        let detail = `Dentro de presupuesto (${formatEur(budget)}), plazo (${maxDays} días) y estancia (${stayDays} días). El stock desplegado cubre a las ${people} personas.`;

        if (totalCost > budget) {
          variant = "no_arriba";
          badge = "Fuera de presupuesto";
          headline = `Excede en ${formatEur(totalCost - budget)}`;
          detail = `El coste calculado (${formatEur(totalCost)}) supera el presupuesto de ${formatEur(budget)}. El stock desplegado aloja a ${stockPeople} de ${people} personas.`;
        } else if (totalDays > maxDays && stockPeople < people) {
          const missing = people - stockPeople;
          const extraStay =
            totalDays > stayDays
              ? ` y supera la estancia de ${stayDays} días`
              : "";
          variant = "no_arriba";
          badge = "Incumple plazo";
          headline = `Montaje (${formatDays(totalDays)} días) > plazo (${maxDays} días)`;
          detail = `El plazo máximo de ${maxDays} días es inferior al montaje (${formatDays(totalDays)} días)${extraStay} (estancia: ${stayDays} días). El stock aloja a ${stockPeople} de ${people} personas; las ${missing} restantes recibirían módulo el día ${Math.ceil(totalDays)}.`;
        } else if (totalDays > stayDays && stockPeople < people) {
          const missing = people - stockPeople;
          variant = "no_arriba";
          badge = "Supera estancia";
          headline = `Montaje (${formatDays(totalDays)} días) > estancia (${stayDays} días)`;
          detail = `El montaje (${formatDays(totalDays)} días) supera la estancia de ${stayDays} días (plazo: ${maxDays} días). El stock aloja a ${stockPeople} de ${people} personas; ${missing} siguen necesitando refugio.`;
        } else if (stockPeople < people) {
          const missing = people - stockPeople;
          variant = "amb_estoc";
          badge = "Cobertura parcial";
          headline =
            stockPeople === 0
              ? `Sin stock in situ · ${missing} personas pendientes`
              : `Stock in situ para ${stockPeople} de ${people} personas`;
          detail = `Dentro de presupuesto (${formatEur(budget - totalCost)} disponibles), plazo (${maxDays} días) y estancia (${stayDays} días). ${missing} personas requieren módulos nuevos.`;
        }

        el("budgetBanner").className = `banner banner-${variant}`;
        el("budgetBadge").className = `badge badge-${variant}`;
        el("budgetBadge").textContent = badge;
        el("budgetHeadline").textContent = headline;
        el("budgetDetail").textContent = detail;
      }

      function renderCost() {
        const people = Math.max(0, Number(el("personasAfectadas").value) || 0);
        const stayDays = Math.max(
          1,
          Number(el("duracionEstanciaDias").value) || 1,
        );
        const maxDays = Math.max(
          1,
          Number(el("plazoMaximoDias").value) || 1,
        );
        const budget = Math.max(
          0,
          Number(el("presupuestoTotalEur").value) || 0,
        );
        const stockModules = Math.max(
          0,
          Number(el("stockModulos").value) || 0,
        );
        const { stockPeople } = getStockCoverage(people, stockModules);
        const percentA = Math.min(
          100,
          Math.max(0, Number(el("percentModulesA").value) || 0),
        );
        const percentB = 100 - percentA;

        el("percentModulesAVal").textContent = String(percentA);
        el("hintPctA").textContent = `${percentA}%`;
        el("hintPctB").textContent = `${percentB}%`;

        const modulesA = getNumberModuleAByPercent(people, percentA);
        const modulesB = getNumberModuleBByPercent(people, percentA);
        const costA = getCostModulesA(people, percentA);
        const costB = getCostModulesB(people, percentA);
        const totalCost = getTotalCost(people, percentA);
        const daysA = getDaysModulesA(people, percentA);
        const daysB = getDaysModulesB(people, percentA);
        const totalDays = getTotalDays(people, percentA);
        const co2A = getCo2ModulesA(people, percentA);
        const co2B = getCo2ModulesB(people, percentA);
        const { totalCo2T: totalCo2, perPersonKg: perPersonCo2Kg } =
          getCo2PerPerson(people, percentA);
        const { perPerson, perPersonNight } = getCostPerPerson(
          people,
          percentA,
          stayDays,
        );
        const { usedPct, remainingEur, isOverBudget } = getBudgetUsage(
          people,
          percentA,
          budget,
        );

        renderBanner(
          people,
          budget,
          totalCost,
          stockPeople,
          stayDays,
          maxDays,
          totalDays,
        );

        el("totalCostVal").textContent = formatEur(totalCost);
        el("totalCostSub").textContent =
          `${formatNum(modulesA + modulesB)} módulos totales (${people} pers.)`;

        el("budgetPctVal").textContent =
          usedPct === null ? "Sin presupuesto" : formatPct(usedPct);
        const budgetFill = el("budgetProgressFill");
        budgetFill.style.width = `${usedPct === null ? 100 : Math.min(100, Math.max(0, usedPct))}%`;
        budgetFill.classList.toggle("is-over-budget", isOverBudget);
        el("budgetRemainingSub").textContent =
          remainingEur >= 0
            ? `${formatEur(remainingEur)} libres de ${formatEur(budget)}`
            : `Excede en ${formatEur(Math.abs(remainingEur))}`;

        el("perPersonVal").textContent = formatEur(perPerson);
        el("perPersonSub").textContent =
          `${formatEur(perPersonNight)} por persona y noche`;

        el("totalDaysVal").textContent = `${formatDays(totalDays)} días`;
        el("totalDaysSub").textContent =
          `${totalDays > maxDays ? "fuera de" : "en"} plazo (${maxDays}d) · ${totalDays > stayDays ? "supera" : "dentro de"} estancia (${stayDays}d)`;

        el("cardModuleA").classList.toggle("is-empty", percentA === 0);
        el("cardModuleB").classList.toggle("is-empty", percentB === 0);

        el("modulesAVal").textContent = `${formatNum(modulesA)} módulos`;
        el("modulesAPctLbl").textContent =
          `${percentA}% del despliegue · ${PROPORTIONS_FACTORS.common.areaM2} m² (${PROPORTIONS_FACTORS.common.capacity} plazas)`;
        el("costAVal").textContent = formatEur(costA);
        el("daysAVal").textContent = `${formatDays(daysA)} días`;
        el("co2AVal").textContent = `${formatCo2T(co2A)} CO₂`;

        el("modulesBVal").textContent = `${formatNum(modulesB)} módulos`;
        el("modulesBPctLbl").textContent =
          `${percentB}% del despliegue · ${PROPORTIONS_FACTORS.common.areaM2} m² (${PROPORTIONS_FACTORS.common.capacity} plazas)`;
        el("costBVal").textContent = formatEur(costB);
        el("daysBVal").textContent = `${formatDays(daysB)} días`;
        el("co2BVal").textContent = `${formatCo2T(co2B)} CO₂`;

        el("barA").style.width = `${percentA}%`;
        el("barB").style.width = `${percentB}%`;
        el("mixTextA").textContent =
          `${formatNum(modulesA)} módulos (${percentA}%)`;
        el("mixTextB").textContent =
          `${formatNum(modulesB)} módulos (${percentB}%)`;

        el("totalCo2Val").textContent = `${formatCo2T(totalCo2)} CO₂`;
        el("perPersonCo2Sub").textContent =
          `${formatCo2Kg(perPersonCo2Kg)} CO₂/pers. · −50% vs hormigón`;
      }

      const PRIORITY_LABELS_ES = {
        rapidez: "Rapidez de despliegue",
        confort: "Confort térmico",
        coste: "Optimización de costes",
        emisiones: "Mínimas emisiones (CO₂)",
        autosuficiencia: "Autosuficiencia energética",
      };

      const PRIORITY_GUIDANCE_ES = {
        rapidez:
          "Prioridad rapidez: despliega primero los módulos en stock in situ y prioriza el Módulo B (3,1 días/módulo frente a 3,6 días del Módulo A).",
        confort:
          "Prioridad confort térmico: chasis con 24 cm de aislamiento de celulosa (U 0,162) combinado con el Kit Climático activo.",
        coste:
          "Prioridad coste: maximiza el % de unidades Módulo B conectadas a red (27.400 €/módulo frente a 33.530 € del Módulo A).",
        emisiones:
          "Prioridad emisiones: el Módulo B reduce la huella a 11,5 t CO₂/módulo (frente a 13,3 t CO₂ del Módulo A con batería y fotovoltaica).",
        autosuficiencia:
          "Prioridad autosuficiencia: prioriza el Módulo A (14 m² de paneles solares + batería 10 kWh) para operación aislada de red.",
      };

      const KIT_UI_ES = {
        calor: {
          id: "calor",
          badge: "C",
          nom: "Heat Kit (Calor)",
          subtitol: "Costa cálida · interior seco · calor húmedo",
          kpis: [
            { val: "−20%", txt: "Ahorro en demanda de refrigeración" },
            { val: "25,6 °C · 55%", txt: "Confort térmico interior y humedad" },
          ],
          components: [
            "Cubierta y fachada de color claro (absortancia 0,2)",
            "Vidrio de control solar",
            "Persiana exterior domotizada activada por radiación solar",
            "Recuperador entálpico (75% calor, 65% humedad)",
          ],
        },
        fred: {
          id: "fred",
          badge: "F",
          nom: "Cold Kit (Frío)",
          subtitol: "Ola de frío continental",
          kpis: [{ val: "0 kWh", txt: "Demanda de calefacción a 22,6 °C" }],
          components: [
            "Vidrio bajo emisivo (g 0,50) para ganancia solar pasiva",
            "Persiana exterior: abierta de día, cerrada de noche",
            "Recuperador de calor en modo invierno",
            "Bomba de calor de respaldo, idéntica en ambos kits",
          ],
        },
      };

      function renderNotices() {
        const accesoCamion = el("accesoCamion").value;
        const requisitoPrioritario = el("requisitoPrioritario").value;
        const isLimited = accesoCamion === "limitado";

        const notices = [
          isLimited
            ? {
                variant: "danger",
                title: "Acceso logístico limitado",
                text: "El tráiler pesado no puede acceder: requiere transporte paletizado de paneles desmontados con vehículo ligero o grúa local.",
              }
            : {
                variant: "info",
                title: "Acceso logístico estándar",
                text: "Acceso directo con camión grúa estándar hasta el punto de montaje.",
              },
          {
            variant: "info",
            title: `Criterio prioritario · ${PRIORITY_LABELS_ES[requisitoPrioritario] ?? PRIORITY_LABELS_ES.confort}`,
            text:
              PRIORITY_GUIDANCE_ES[requisitoPrioritario] ??
              PRIORITY_GUIDANCE_ES.confort,
          },
        ];

        el("operationalNotices").replaceChildren(
          ...notices.map((notice) => {
            const div = document.createElement("div");
            div.className = `aviso aviso-${notice.variant}`;
            const strong = document.createElement("strong");
            strong.textContent = `${notice.title}: `;
            div.append(strong, document.createTextNode(notice.text));
            return div;
          }),
        );
      }

      function renderKit(escenarioId) {
        const kitKey = SCENARIO_KIT[escenarioId] ?? "calor";
        const kit = KIT_UI_ES[kitKey];
        if (!kit) return;

        const badge = el("kitBadge");
        badge.textContent = kit.badge;
        badge.className = `kit-badge kit-badge-${kit.id}`;

        el("kitTitle").textContent = kit.nom;
        el("kitSubtitle").textContent = kit.subtitol;

        const kpis = el("kitKpis");
        kpis.replaceChildren(
          ...kit.kpis.map((kpi) => {
            const box = document.createElement("div");
            box.className = `kit-kpi kit-kpi-${kit.id}`;
            const val = document.createElement("div");
            val.className = "kit-kpi-val";
            val.textContent = kpi.val;
            const txt = document.createElement("div");
            txt.className = "kit-kpi-txt";
            txt.textContent = kpi.txt;
            box.append(val, txt);
            return box;
          }),
        );

        const list = el("kitList");
        list.replaceChildren(
          ...kit.components.map((item) => {
            const li = document.createElement("li");
            li.textContent = item;
            return li;
          }),
        );
      }

      function markCustomCase() {
        const sel = el("caseSelector");
        if (sel && sel.value !== "custom") {
          sel.value = "custom";
        }
      }

      el("caseSelector")?.addEventListener("change", (e) => {
        const c = CASES_BY_ID.get(e.target.value);
        if (!c) return;
        const inp = c.input;
        el("escenarioId").value = inp.escenarioId;
        el("personasAfectadas").value = String(inp.personasAfectadas);
        el("duracionEstanciaDias").value = String(inp.duracionEstanciaDias);
        el("plazoMaximoDias").value = String(inp.plazoMaximoDias);
        el("presupuestoTotalEur").value = String(inp.presupuestoTotalEur);
        el("accesoCamion").value = inp.accesoCamion;
        el("requisitoPrioritario").value = inp.requisitoPrioritario;
        el("percentModulesA").value = String(
          getModuleMixFromRedPct(inp.pctConexionRed).percentModulesA,
        );
        renderKit(inp.escenarioId);
        renderNotices();
        renderCost();
      });

      el("escenarioId").addEventListener("change", () => {
        markCustomCase();
        renderKit(el("escenarioId").value);
      });

      [
        "personasAfectadas",
        "duracionEstanciaDias",
        "plazoMaximoDias",
        "presupuestoTotalEur",
        "stockModulos",
        "percentModulesA",
      ].forEach((id) => {
        el(id).addEventListener("input", () => {
          markCustomCase();
          renderCost();
        });
      });

      ["accesoCamion", "requisitoPrioritario"].forEach((id) => {
        el(id).addEventListener("change", () => {
          markCustomCase();
          renderNotices();
        });
      });

      el("toggleSidebarBtn")?.addEventListener("click", () => {
        const fields = el("sidebarFields");
        const btn = el("toggleSidebarBtn");
        const collapsed = fields.classList.toggle("is-collapsed");
        btn.setAttribute("aria-expanded", String(!collapsed));
        btn.textContent = collapsed ? "Mostrar" : "Ocultar";
      });

      const tabOrder = ["dashboard", "sensors"];
      const tabIds = {
        dashboard: "tabDashboard",
        sensors: "tabSensors",
      };

      function switchTab(activeTab) {
        const isDashboard = activeTab === "dashboard";
        const isSensors = activeTab === "sensors";

        el("panelDashboard").hidden = !isDashboard;
        el("panelSensors").hidden = !isSensors;

        el("tabDashboard").classList.toggle("is-active", isDashboard);
        el("tabSensors").classList.toggle("is-active", isSensors);

        el("tabDashboard").setAttribute("aria-selected", String(isDashboard));
        el("tabSensors").setAttribute("aria-selected", String(isSensors));
      }

      el("tabDashboard").addEventListener("click", () => switchTab("dashboard"));
      el("tabSensors").addEventListener("click", () => switchTab("sensors"));

      tabOrder.forEach((tabKey, idx) => {
        el(tabIds[tabKey])?.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          const nextIdx =
            e.key === "ArrowRight"
              ? (idx + 1) % tabOrder.length
              : (idx - 1 + tabOrder.length) % tabOrder.length;
          const nextKey = tabOrder[nextIdx];
          switchTab(nextKey);
          el(tabIds[nextKey])?.focus();
        });
      });
    </script>
  </body>
</html>
