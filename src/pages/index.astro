---
import "../styles/index.css";
import {
  getBudgetUsage,
  getCases,
  getCo2ModulesA,
  getCo2ModulesB,
  getCo2PerPerson,
  getCostModulesA,
  getCostModulesB,
  getCostPerPerson,
  getDaysModulesA,
  getDaysModulesB,
  getKitForScenario,
  getModuleMixFromRedPct,
  getNumberModuleAByPercent,
  getNumberModuleBByPercent,
  getOperationalNotices,
  getStockCoverage,
  getTotalCo2,
  getTotalCost,
  getTotalDays,
  inputLabels,
  KITS,
  PRIORITY_LABELS,
  PROPORTIONS_FACTORS,
  SCENARIO_KIT,
  snarioLabels,
  TRUCK_ACCESS_LABELS,
} from "../lib/desition-engine.js";

const SCENARIO_LABELS = snarioLabels;

// 60 casos d'emergència del dataset
const CASES = getCases();
const defaultCase = CASES.find((c) => c.id === "EM059") ?? CASES[0];
const initialInput = { ...defaultCase.input };
const initialPercentA = getModuleMixFromRedPct(
  initialInput.pctConexionRed,
).percentModulesA;
const initialKit = getKitForScenario(initialInput.escenarioId);
const initialTotalCost = getTotalCost(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialModulesA = getNumberModuleAByPercent(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialModulesB = getNumberModuleBByPercent(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCostA = getCostModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCostB = getCostModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialBudget = initialInput.presupuestoTotalEur;
const initialStayDays = initialInput.duracionEstanciaDias;
const initialMaxDays = initialInput.plazoMaximoDias;
const DEFAULT_STOCK_MODULES = 4;
const initialStock = getStockCoverage(
  initialInput.personasAfectadas,
  DEFAULT_STOCK_MODULES,
);
const initialDaysA = getDaysModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialDaysB = getDaysModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialTotalDays = getTotalDays(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialPersonCost = getCostPerPerson(
  initialInput.personasAfectadas,
  initialPercentA,
  initialStayDays,
);
const initialCo2A = getCo2ModulesA(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialCo2B = getCo2ModulesB(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialTotalCo2 = getTotalCo2(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialPersonCo2 = getCo2PerPerson(
  initialInput.personasAfectadas,
  initialPercentA,
);
const initialBudgetUsage = getBudgetUsage(
  initialInput.personasAfectadas,
  initialPercentA,
  initialBudget,
);
const initialNotices = getOperationalNotices({
  accesoCamion: initialInput.accesoCamion,
  requisitoPrioritario: initialInput.requisitoPrioritario,
});
const formatEur = (val) =>
  `${Math.round(val).toLocaleString("en-US")} €`;
const formatDays = (val) =>
  val.toLocaleString("en-US", { maximumFractionDigits: 1 });
const formatCo2T = (val) =>
  `${val.toLocaleString("en-US", { maximumFractionDigits: 1 })} t`;
const formatCo2Kg = (val) =>
  `${Math.round(val).toLocaleString("en-US")} kg`;
const formatPct = (val) =>
  `${val.toLocaleString("en-US", { maximumFractionDigits: 1 })}%`;

function getBannerState(
  people,
  budget,
  totalCost,
  stockPeople,
  stayDays,
  maxDays,
  totalDays,
) {
  if (totalCost > budget) {
    return {
      variant: "no_arriba",
      badge: "Over budget",
      headline: `Exceeds by ${formatEur(totalCost - budget)}`,
      detail: `Calculated cost (${formatEur(totalCost)}) exceeds the budget of ${formatEur(budget)}. Deployed stock houses ${stockPeople} of ${people} people.`,
    };
  }
  if (totalDays > maxDays && stockPeople < people) {
    const missing = people - stockPeople;
    const extraStay =
      totalDays > stayDays ? ` and exceeds the ${stayDays}-day stay` : "";
    return {
      variant: "no_arriba",
      badge: "Misses deadline",
      headline: `Assembly (${formatDays(totalDays)} days) > deadline (${maxDays} days)`,
      detail: `The ${maxDays}-day deadline is shorter than assembly (${formatDays(totalDays)} days)${extraStay} (stay: ${stayDays} days). Deployed stock houses ${stockPeople} of ${people} people; the remaining ${missing} would get a module on day ${Math.ceil(totalDays)}.`,
    };
  }
  if (totalDays > stayDays && stockPeople < people) {
    const missing = people - stockPeople;
    return {
      variant: "no_arriba",
      badge: "Exceeds stay",
      headline: `Assembly (${formatDays(totalDays)} days) > stay (${stayDays} days)`,
      detail: `Assembly (${formatDays(totalDays)} days) exceeds the ${stayDays}-day stay (deadline: ${maxDays} days). Deployed stock houses ${stockPeople} of ${people} people; ${missing} still need housing.`,
    };
  }
  const freeBudget = formatEur(budget - totalCost);
  if (stockPeople < people) {
    const missing = people - stockPeople;
    return {
      variant: "amb_estoc",
      badge: "Partial coverage",
      headline:
        stockPeople === 0
          ? `No on-site stock · ${missing} people pending`
          : `On-site stock for ${stockPeople} of ${people} people`,
      detail: `Within budget (${freeBudget} remaining), deadline (${maxDays} days), and stay (${stayDays} days). ${missing} people need to be housed with new modules.`,
    };
  }
  return {
    variant: "viable",
    badge: "Full coverage",
    headline: `${freeBudget} remaining`,
    detail: `Within budget (${formatEur(budget)}), deadline (${maxDays} days), and stay (${stayDays} days). Deployed stock houses all ${people} people.`,
  };
}

const initialBanner = getBannerState(
  initialInput.personasAfectadas,
  initialBudget,
  initialTotalCost,
  initialStock.stockPeople,
  initialStayDays,
  initialMaxDays,
  initialTotalDays,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>A Decision-Making Dashboard · ATOM Modular</title>
  </head>
  <body>
    <main class="page">
      <header class="page-header">
        <div>
          <div class="eyebrow">ATOM Modular · Emergency Deployment Planner</div>
          <h1>A Decision-Making Dashboard</h1>
        </div>

        <div class="tabs" role="tablist">
          <button
            id="tabDashboard"
            type="button"
            class="tab-btn is-active"
            role="tab"
            aria-selected="true"
          >
            Dashboard
          </button>
          <button
            id="tabFormulas"
            type="button"
            class="tab-btn"
            role="tab"
            aria-selected="false"
          >
            Formulas &amp; criteria
          </button>
        </div>
      </header>

      <div id="panelDashboard" class="layout">
        <aside class="card sidebar">
          <h2>Case parameters</h2>

          <div class="field">
            <label for="escenarioId">{inputLabels.Clima}</label>
            <select id="escenarioId">
              {
                Object.entries(SCENARIO_LABELS).map(([k, lbl]) => (
                  <option value={k} selected={k === initialInput.escenarioId}>
                    {lbl}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="personasAfectadas">Affected people</label>
              <input
                id="personasAfectadas"
                type="number"
                min="0"
                step="1"
                value={initialInput.personasAfectadas}
              />
            </div>

            <div class="field">
              <label for="duracionEstanciaDias">Stay duration (days)</label>
              <input
                id="duracionEstanciaDias"
                type="number"
                min="1"
                step="1"
                value={initialStayDays}
              />
            </div>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="plazoMaximoDias">Max deadline (days)</label>
              <input
                id="plazoMaximoDias"
                type="number"
                min="1"
                step="1"
                value={initialMaxDays}
              />
            </div>

            <div class="field">
              <label for="stockModulos">On-site shelter modules</label>
              <input
                id="stockModulos"
                type="number"
                min="0"
                step="1"
                value={DEFAULT_STOCK_MODULES}
              />
            </div>
          </div>

          <div class="field">
            <label for="presupuestoTotalEur">Total budget (€)</label>
            <input
              id="presupuestoTotalEur"
              type="number"
              min="0"
              step="1000"
              value={initialBudget}
            />
          </div>

          <div class="field">
            <label for="accesoCamion">{inputLabels.AccesoCamion}</label>
            <select id="accesoCamion">
              {
                Object.entries(TRUCK_ACCESS_LABELS).map(([k, lbl]) => (
                  <option value={k} selected={k === initialInput.accesoCamion}>
                    {lbl}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="field">
            <label for="requisitoPrioritario">{inputLabels.Prioridad}</label>
            <select id="requisitoPrioritario">
              {
                Object.entries(PRIORITY_LABELS).map(([k, lbl]) => (
                  <option
                    value={k}
                    selected={k === initialInput.requisitoPrioritario}
                  >
                    {lbl}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="field">
            <label for="percentModulesA">
              Self-sufficient modules A (<span id="percentModulesAVal">{initialPercentA}</span>%)
            </label>
            <input
              id="percentModulesA"
              type="range"
              min="0"
              max="100"
              step="1"
              value={initialPercentA}
            />
            <div class="hint">
              <span>A (self-sufficient): <strong id="hintPctA">{initialPercentA}%</strong></span>
              <span>B (grid-connected): <strong id="hintPctB">{100 - initialPercentA}%</strong></span>
            </div>
          </div>
        </aside>

        <section>
          <div
            id="budgetBanner"
            class={`banner banner-${initialBanner.variant}`}
          >
            <div>
              <span
                id="budgetBadge"
                class={`badge badge-${initialBanner.variant}`}
              >
                {initialBanner.badge}
              </span>
              <strong id="budgetHeadline">{initialBanner.headline}</strong>
            </div>
            <div id="budgetDetail" class="banner-detail">
              {initialBanner.detail}
            </div>
          </div>

          <div class="kpis">
            <div class="kpi">
              <div class="kpi-label">Estimated total cost</div>
              <div id="totalCostVal" class="kpi-val">
                {formatEur(initialTotalCost)}
              </div>
              <div id="totalCostSub" class="kpi-sub">
                {initialModulesA + initialModulesB} total modules
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Budget used</div>
              <div id="budgetPctVal" class="kpi-val">
                {formatPct(initialBudgetUsage.usedPct)}
              </div>
              <div class="progress-track">
                <div
                  id="budgetProgressFill"
                  class="progress-fill"
                  style={`width: ${Math.min(100, Math.max(0, initialBudgetUsage.usedPct))}%`}
                ></div>
              </div>
              <div id="budgetRemainingSub" class="kpi-sub">
                {
                  initialBudgetUsage.remainingEur >= 0
                    ? `${formatEur(initialBudgetUsage.remainingEur)} available of ${formatEur(initialBudget)}`
                    : `Exceeds by ${formatEur(Math.abs(initialBudgetUsage.remainingEur))}`
                }
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Cost per person</div>
              <div id="perPersonVal" class="kpi-val">
                {formatEur(initialPersonCost.perPerson)}
              </div>
              <div id="perPersonSub" class="kpi-sub">
                {formatEur(initialPersonCost.perPersonNight)} per person and night
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Deployment time</div>
              <div id="totalDaysVal" class="kpi-val">
                {formatDays(initialTotalDays)} days
              </div>
              <div id="totalDaysSub" class="kpi-sub">
                {
                  `${initialTotalDays > initialMaxDays ? "outside" : "within"} deadline (${initialMaxDays}d) · ${initialTotalDays > initialStayDays ? "outside" : "within"} stay (${initialStayDays}d)`
                }
              </div>
            </div>

            <div class="kpi">
              <div class="kpi-label">Embodied CO₂</div>
              <div id="totalCo2Val" class="kpi-val">
                {formatCo2T(initialTotalCo2)} CO₂
              </div>
              <div id="perPersonCo2Sub" class="kpi-sub">
                {formatCo2Kg(initialPersonCo2.perPersonKg)} CO₂ per person
              </div>
            </div>
          </div>

          <div class="ab-grid">
            <div
              id="cardModuleA"
              class={`ab-card ab-card-a ${initialPercentA === 0 ? "is-empty" : ""}`}
            >
              <div class="ab-header">
                <span class="ab-badge ab-badge-a">
                  {PROPORTIONS_FACTORS.moduleA.id}
                </span>
                <div>
                  <div class="ab-title">
                    Module {PROPORTIONS_FACTORS.moduleA.id} ·{" "}
                    {PROPORTIONS_FACTORS.moduleA.name}
                  </div>
                  <div class="ab-sub">
                    {PROPORTIONS_FACTORS.moduleA.description}
                  </div>
                </div>
              </div>
              <div class="ab-rows">
                <div class="ab-row">
                  <div id="modulesAVal" class="ab-val ab-val-a">
                    {initialModulesA} modules
                  </div>
                  <div id="modulesAPctLbl" class="ab-lbl">
                    {initialPercentA}% of deployment ·{" "}
                    {PROPORTIONS_FACTORS.common.areaM2} m² (
                    {PROPORTIONS_FACTORS.common.capacity} beds)
                  </div>
                </div>
                <div class="ab-row">
                  <div id="costAVal" class="ab-val ab-val-a">
                    {formatEur(initialCostA)}
                  </div>
                  <div class="ab-lbl">
                    {formatEur(PROPORTIONS_FACTORS.moduleA.costEur)} per module
                  </div>
                </div>
                <div class="ab-row">
                  <div id="daysAVal" class="ab-val ab-val-a">
                    {formatDays(initialDaysA)} days
                  </div>
                  <div class="ab-lbl">
                    {formatDays(PROPORTIONS_FACTORS.moduleA.assemblyDays)} days /
                    module ({PROPORTIONS_FACTORS.common.parallelTeams} teams)
                  </div>
                </div>
                <div class="ab-row">
                  <div id="co2AVal" class="ab-val ab-val-a">
                    {formatCo2T(initialCo2A)} CO₂
                  </div>
                  <div class="ab-lbl">
                    {formatCo2T(PROPORTIONS_FACTORS.moduleA.co2T)} CO₂ per module
                  </div>
                </div>
              </div>
            </div>

            <div
              id="cardModuleB"
              class={`ab-card ab-card-b ${initialPercentA === 100 ? "is-empty" : ""}`}
            >
              <div class="ab-header">
                <span class="ab-badge ab-badge-b">
                  {PROPORTIONS_FACTORS.moduleB.id}
                </span>
                <div>
                  <div class="ab-title">
                    Module {PROPORTIONS_FACTORS.moduleB.id} ·{" "}
                    {PROPORTIONS_FACTORS.moduleB.name}
                  </div>
                  <div class="ab-sub">
                    {PROPORTIONS_FACTORS.moduleB.description}
                  </div>
                </div>
              </div>
              <div class="ab-rows">
                <div class="ab-row">
                  <div id="modulesBVal" class="ab-val ab-val-b">
                    {initialModulesB} modules
                  </div>
                  <div id="modulesBPctLbl" class="ab-lbl">
                    {100 - initialPercentA}% of deployment ·{" "}
                    {PROPORTIONS_FACTORS.common.areaM2} m² (
                    {PROPORTIONS_FACTORS.common.capacity} beds)
                  </div>
                </div>
                <div class="ab-row">
                  <div id="costBVal" class="ab-val ab-val-b">
                    {formatEur(initialCostB)}
                  </div>
                  <div class="ab-lbl">
                    {formatEur(PROPORTIONS_FACTORS.moduleB.costEur)} per module
                  </div>
                </div>
                <div class="ab-row">
                  <div id="daysBVal" class="ab-val ab-val-b">
                    {formatDays(initialDaysB)} days
                  </div>
                  <div class="ab-lbl">
                    {formatDays(PROPORTIONS_FACTORS.moduleB.assemblyDays)} days /
                    module ({PROPORTIONS_FACTORS.common.parallelTeams} teams)
                  </div>
                </div>
                <div class="ab-row">
                  <div id="co2BVal" class="ab-val ab-val-b">
                    {formatCo2T(initialCo2B)} CO₂
                  </div>
                  <div class="ab-lbl">
                    {formatCo2T(PROPORTIONS_FACTORS.moduleB.co2T)} CO₂ per module
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mid-grid">
            <div class="card">
              <div class="section-title">
                Module split &amp; common chassis
              </div>
              <div class="stacked-bar">
                <div
                  id="barA"
                  class="bar-a"
                  style={`width: ${initialPercentA}%`}
                ></div>
                <div
                  id="barB"
                  class="bar-b"
                  style={`width: ${100 - initialPercentA}%`}
                ></div>
              </div>
              <div class="mix-row">
                <span class="dot" style="background: var(--teal);"></span>
                <span>
                  Module A (self-sufficient):{" "}
                  <strong id="mixTextA">
                    {initialModulesA} modules ({initialPercentA}%)
                  </strong>
                </span>
              </div>
              <div class="mix-row">
                <span class="dot" style="background: var(--amber);"></span>
                <span>
                  Module B (grid-connected):{" "}
                  <strong id="mixTextB">
                    {initialModulesB} modules ({100 - initialPercentA}%)
                  </strong>
                </span>
              </div>
              <div class="kpi-sub" style="margin-top: 0.65rem;">
                Common chassis ({PROPORTIONS_FACTORS.common.areaM2} m² ·{" "}
                {PROPORTIONS_FACTORS.common.capacity} beds):{" "}
                {PROPORTIONS_FACTORS.common.chassis}
              </div>

              <div id="operationalNotices" style="margin-top: 0.85rem;">
                {
                  initialNotices.map((notice) => (
                    <div class={`aviso aviso-${notice.variant}`}>
                      <strong>{notice.title}:</strong> {notice.text}
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="card">
              <div class="kit-header">
                <span
                  id="kitBadge"
                  class={`kit-badge kit-badge-${initialKit.id}`}
                >
                  {initialKit.badge}
                </span>
                <div>
                  <div id="kitTitle" class="section-title">{initialKit.nom}</div>
                  <div id="kitSubtitle" class="ab-sub">{initialKit.subtitol}</div>
                </div>
              </div>

              <div id="kitKpis" class="kit-kpis">
                {
                  initialKit.kpis.map((kpi) => (
                    <div class={`kit-kpi kit-kpi-${initialKit.id}`}>
                      <div class="kit-kpi-val">{kpi.val}</div>
                      <div class="kit-kpi-txt">{kpi.txt}</div>
                    </div>
                  ))
                }
              </div>

              <ul id="kitList" class="kit-list">
                {initialKit.components.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>
      </div>

      <section id="panelFormulas" hidden>
        <div class="card">
          <div class="section-title">
            How the calculation works (step by step)
          </div>
          <ul class="kit-list">
            <li>
              <strong>1. How many modules are needed?</strong> Each module houses{" "}
              <strong>4 people</strong>. The total number of modules is calculated
              and split according to the chosen percentage between{" "}
              <strong>Module A (self-sufficient)</strong> and{" "}
              <strong>Module B (grid-connected)</strong>:
              <div class="formula-box">
                Total modules = Affected people ÷ 4<br />
                Modules A = Total modules × (% A ÷ 100)<br />
                Modules B = Total modules × ((100 − % A) ÷ 100)
              </div>
            </li>
            <li>
              <strong>2. How much does deployment cost?</strong> Each Module A
              costs <strong>33,530 €</strong> and each Module B costs{" "}
              <strong>27,400 €</strong> (manufactured and installed):
              <div class="formula-box">
                Total cost = (Modules A × 33,530 €) + (Modules B × 27,400 €)<br />
                % of budget = (Total cost ÷ Available budget) × 100<br />
                Remaining budget = Available budget − Total cost<br />
                Cost per person = Total cost ÷ Affected people<br />
                Cost per person and night = Cost per person ÷ Stay days
              </div>
            </li>
            <li>
              <strong>3. How many days does assembly take?</strong> A Module A
              requires <strong>3.6 days</strong> and a Module B requires{" "}
              <strong>3.1 days</strong>, with{" "}
              <strong>10 teams working in parallel</strong>:
              <div class="formula-box">
                Days Modules A = (Modules A × 3.6 days) ÷ 10 teams<br />
                Days Modules B = (Modules B × 3.1 days) ÷ 10 teams<br />
                Total deployment days = Days Modules A + Days Modules B
              </div>
            </li>
            <li>
              <strong>4. What do on-site shelter modules cover?</strong>{" "}
              Each module already available on the ground immediately houses{" "}
              <strong>4 people</strong> (up to the total number of affected people):
              <div class="formula-box">
                Immediate on-site beds = On-site shelter modules × 4<br />
                People waiting for a new module = Affected people − Immediate
                covered beds
              </div>
            </li>
            <li>
              <strong>5. How is the top alert banner (traffic light) decided?</strong>
              <ul class="kit-list">
                <li>
                  <strong>Red (Over budget):</strong> Total cost &gt; Available
                  budget.
                </li>
                <li>
                  <strong>Red (Misses deadline):</strong> Total deployment days
                  &gt; Max deadline and there are still people waiting for a
                  module.
                </li>
                <li>
                  <strong>Red (Exceeds stay):</strong> Total deployment days
                  &gt; Stay days and there are still people waiting for a
                  module.
                </li>
                <li>
                  <strong>Amber (Partial coverage):</strong> Total cost ≤
                  Budget and Total days ≤ Deadline and Stay, but immediate
                  on-site beds are fewer than affected people.
                </li>
                <li>
                  <strong>Green (Full coverage):</strong> Total cost ≤
                  Budget, Total days ≤ Deadline and Stay, and immediate on-site
                  beds cover all affected people.
                </li>
              </ul>
            </li>
            <li>
              <strong>6. Which climate kit is selected?</strong> All modules
              share the same 22 m² timber chassis, and depending on the climate
              they are equipped with the <strong>Heat Kit</strong> (coastal
              heatwave, inland heatwave, or humid post-storm;{" "}
              <strong>−20%</strong> cooling demand savings and thermal comfort at{" "}
              <strong>25.6 °C · 55% humidity</strong>) or the{" "}
              <strong>Cold Kit</strong> (continental cold; heating demand of{" "}
              <strong>0 kWh at 22.6 °C</strong>).
            </li>
            <li>
              <strong>7. Embodied CO₂ (total and per person):</strong> Each
              Module A embodies <strong>13.3 t</strong> of CO₂ and each Module B
              embodies <strong>11.5 t</strong>:
              <div class="formula-box">
                Total CO₂ (t) = (Modules A × 13.3 t) + (Modules B × 11.5 t)<br />
                CO₂ per person (kg) = (Total CO₂ × 1,000) ÷ Affected people
              </div>
            </li>
            <li>
              <strong>
                8. Visual split and Module A &amp; B specification cards:
              </strong>{" "}
              The stacked bar shows the proportion between Module A and Module B
              built on the common 22 m² chassis (4 beds), and the cards compare
              cost, parallel assembly days, and embodied CO₂ for each type.
            </li>
            <li>
              <strong>9. Truck access and priority requirement:</strong> Depending
              on logistics access (standard crane truck or limited access with
              palletized disassembled panels) and case priority (speed, comfort,
              cost, emissions, or self-sufficiency), the dashboard generates
              operational notices to guide deployment.
            </li>
          </ul>
        </div>
      </section>
    </main>

    <script
      define:vars={{
        KITS,
        PRIORITY_LABELS,
        PROPORTIONS_FACTORS,
        SCENARIO_KIT,
      }}
    >
      const el = (id) => document.getElementById(id);

      const getPeopleForModule =
        PROPORTIONS_FACTORS.peopleForModule.modules /
        PROPORTIONS_FACTORS.peopleForModule.people;

      function getNumberModuleAByPercent(people, percentModulesA) {
        return (people * getPeopleForModule * percentModulesA) / 100;
      }

      function getCostModulesA(people, percentModulesA) {
        return (
          getNumberModuleAByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleA.costEur
        );
      }

      function getNumberModuleBByPercent(people, percentModulesA) {
        return (people * getPeopleForModule * (100 - percentModulesA)) / 100;
      }

      function getCostModulesB(people, percentModulesA) {
        return (
          getNumberModuleBByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleB.costEur
        );
      }

      function getTotalCost(people, percentModulesA) {
        return (
          getCostModulesA(people, percentModulesA) +
          getCostModulesB(people, percentModulesA)
        );
      }

      function getKDaysModules(daysForModule) {
        return getPeopleForModule * daysForModule;
      }

      function getDaysModulesA(people, percentModulesA) {
        return (
          (people *
            getKDaysModules(PROPORTIONS_FACTORS.moduleA.assemblyDays) *
            percentModulesA) /
          100 /
          PROPORTIONS_FACTORS.common.parallelTeams
        );
      }

      function getDaysModulesB(people, percentModulesA) {
        return (
          (people *
            getKDaysModules(PROPORTIONS_FACTORS.moduleB.assemblyDays) *
            (100 - percentModulesA)) /
          100 /
          PROPORTIONS_FACTORS.common.parallelTeams
        );
      }

      function getTotalDays(people, percentModulesA) {
        return (
          getDaysModulesA(people, percentModulesA) +
          getDaysModulesB(people, percentModulesA)
        );
      }

      function getCo2ModulesA(people, percentModulesA) {
        return (
          getNumberModuleAByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleA.co2T
        );
      }

      function getCo2ModulesB(people, percentModulesA) {
        return (
          getNumberModuleBByPercent(people, percentModulesA) *
          PROPORTIONS_FACTORS.moduleB.co2T
        );
      }

      function getTotalCo2(people, percentModulesA) {
        return (
          getCo2ModulesA(people, percentModulesA) +
          getCo2ModulesB(people, percentModulesA)
        );
      }

      function formatEur(val) {
        return `${Math.round(val).toLocaleString("en-US")} €`;
      }

      function formatNum(val) {
        return Number.isInteger(val) ? String(val) : val.toFixed(1);
      }

      function formatDays(val) {
        return val.toLocaleString("en-US", { maximumFractionDigits: 1 });
      }

      function formatCo2T(val) {
        return `${val.toLocaleString("en-US", { maximumFractionDigits: 1 })} t`;
      }

      function formatCo2Kg(val) {
        return `${Math.round(val).toLocaleString("en-US")} kg`;
      }

      function formatPct(val) {
        return `${val.toLocaleString("en-US", { maximumFractionDigits: 1 })}%`;
      }

      function renderBanner(
        people,
        budget,
        totalCost,
        stockPeople,
        stayDays,
        maxDays,
        totalDays,
      ) {
        let variant = "viable";
        let badge = "Full coverage";
        let headline = `${formatEur(budget - totalCost)} remaining`;
        let detail = `Within budget (${formatEur(budget)}), deadline (${maxDays} days), and stay (${stayDays} days). Deployed stock houses all ${people} people.`;

        if (totalCost > budget) {
          variant = "no_arriba";
          badge = "Over budget";
          headline = `Exceeds by ${formatEur(totalCost - budget)}`;
          detail = `Calculated cost (${formatEur(totalCost)}) exceeds the budget of ${formatEur(budget)}. Deployed stock houses ${stockPeople} of ${people} people.`;
        } else if (totalDays > maxDays && stockPeople < people) {
          const missing = people - stockPeople;
          const extraStay =
            totalDays > stayDays
              ? ` and exceeds the ${stayDays}-day stay`
              : "";
          variant = "no_arriba";
          badge = "Misses deadline";
          headline = `Assembly (${formatDays(totalDays)} days) > deadline (${maxDays} days)`;
          detail = `The ${maxDays}-day deadline is shorter than assembly (${formatDays(totalDays)} days)${extraStay} (stay: ${stayDays} days). Deployed stock houses ${stockPeople} of ${people} people; the remaining ${missing} would get a module on day ${Math.ceil(totalDays)}.`;
        } else if (totalDays > stayDays && stockPeople < people) {
          const missing = people - stockPeople;
          variant = "no_arriba";
          badge = "Exceeds stay";
          headline = `Assembly (${formatDays(totalDays)} days) > stay (${stayDays} days)`;
          detail = `Assembly (${formatDays(totalDays)} days) exceeds the ${stayDays}-day stay (deadline: ${maxDays} days). Deployed stock houses ${stockPeople} of ${people} people; ${missing} still need housing.`;
        } else if (stockPeople < people) {
          const missing = people - stockPeople;
          variant = "amb_estoc";
          badge = "Partial coverage";
          headline =
            stockPeople === 0
              ? `No on-site stock · ${missing} people pending`
              : `On-site stock for ${stockPeople} of ${people} people`;
          detail = `Within budget (${formatEur(budget - totalCost)} remaining), deadline (${maxDays} days), and stay (${stayDays} days). ${missing} people need to be housed with new modules.`;
        }

        el("budgetBanner").className = `banner banner-${variant}`;
        el("budgetBadge").className = `badge badge-${variant}`;
        el("budgetBadge").textContent = badge;
        el("budgetHeadline").textContent = headline;
        el("budgetDetail").textContent = detail;
      }

      function renderCost() {
        const people = Math.max(0, Number(el("personasAfectadas").value) || 0);
        const stayDays = Math.max(
          1,
          Number(el("duracionEstanciaDias").value) || 1,
        );
        const maxDays = Math.max(
          1,
          Number(el("plazoMaximoDias").value) || 1,
        );
        const budget = Math.max(
          0,
          Number(el("presupuestoTotalEur").value) || 0,
        );
        const stockModules = Math.max(
          0,
          Number(el("stockModulos").value) || 0,
        );
        const stockPeople = Math.min(
          people,
          stockModules * PROPORTIONS_FACTORS.common.capacity,
        );
        const percentA = Math.min(
          100,
          Math.max(0, Number(el("percentModulesA").value) || 0),
        );
        const percentB = 100 - percentA;

        el("percentModulesAVal").textContent = String(percentA);
        el("hintPctA").textContent = `${percentA}%`;
        el("hintPctB").textContent = `${percentB}%`;

        const modulesA = getNumberModuleAByPercent(people, percentA);
        const modulesB = getNumberModuleBByPercent(people, percentA);
        const costA = getCostModulesA(people, percentA);
        const costB = getCostModulesB(people, percentA);
        const totalCost = getTotalCost(people, percentA);
        const daysA = getDaysModulesA(people, percentA);
        const daysB = getDaysModulesB(people, percentA);
        const totalDays = getTotalDays(people, percentA);
        const co2A = getCo2ModulesA(people, percentA);
        const co2B = getCo2ModulesB(people, percentA);
        const totalCo2 = getTotalCo2(people, percentA);
        const perPersonCo2Kg = people > 0 ? (totalCo2 * 1000) / people : 0;
        const perPerson = people > 0 ? totalCost / people : 0;
        const perPersonNight = perPerson / stayDays;
        const usedPct = budget > 0 ? (totalCost / budget) * 100 : 0;
        const remainingEur = budget - totalCost;

        renderBanner(
          people,
          budget,
          totalCost,
          stockPeople,
          stayDays,
          maxDays,
          totalDays,
        );

        el("totalCostVal").textContent = formatEur(totalCost);
        el("totalCostSub").textContent =
          `${formatNum(modulesA + modulesB)} total modules`;

        el("budgetPctVal").textContent = formatPct(usedPct);
        el("budgetProgressFill").style.width =
          `${Math.min(100, Math.max(0, usedPct))}%`;
        el("budgetRemainingSub").textContent =
          remainingEur >= 0
            ? `${formatEur(remainingEur)} available of ${formatEur(budget)}`
            : `Exceeds by ${formatEur(Math.abs(remainingEur))}`;

        el("perPersonVal").textContent = formatEur(perPerson);
        el("perPersonSub").textContent =
          `${formatEur(perPersonNight)} per person and night`;

        el("totalDaysVal").textContent = `${formatDays(totalDays)} days`;
        el("totalDaysSub").textContent =
          `${totalDays > maxDays ? "outside" : "within"} deadline (${maxDays}d) · ${totalDays > stayDays ? "outside" : "within"} stay (${stayDays}d)`;

        el("cardModuleA").classList.toggle("is-empty", percentA === 0);
        el("cardModuleB").classList.toggle("is-empty", percentB === 0);

        el("modulesAVal").textContent = `${formatNum(modulesA)} modules`;
        el("modulesAPctLbl").textContent =
          `${percentA}% of deployment · ${PROPORTIONS_FACTORS.common.areaM2} m² (${PROPORTIONS_FACTORS.common.capacity} beds)`;
        el("costAVal").textContent = formatEur(costA);
        el("daysAVal").textContent = `${formatDays(daysA)} days`;
        el("co2AVal").textContent = `${formatCo2T(co2A)} CO₂`;

        el("modulesBVal").textContent = `${formatNum(modulesB)} modules`;
        el("modulesBPctLbl").textContent =
          `${percentB}% of deployment · ${PROPORTIONS_FACTORS.common.areaM2} m² (${PROPORTIONS_FACTORS.common.capacity} beds)`;
        el("costBVal").textContent = formatEur(costB);
        el("daysBVal").textContent = `${formatDays(daysB)} days`;
        el("co2BVal").textContent = `${formatCo2T(co2B)} CO₂`;

        el("barA").style.width = `${percentA}%`;
        el("barB").style.width = `${percentB}%`;
        el("mixTextA").textContent =
          `${formatNum(modulesA)} modules (${percentA}%)`;
        el("mixTextB").textContent =
          `${formatNum(modulesB)} modules (${percentB}%)`;

        el("totalCo2Val").textContent = `${formatCo2T(totalCo2)} CO₂`;
        el("perPersonCo2Sub").textContent =
          `${formatCo2Kg(perPersonCo2Kg)} CO₂ per person`;
      }

      const PRIORITY_GUIDANCE = {
        rapidez:
          "Speed priority: deploy on-site shelter modules first and prioritize Module B (3.1 days/module vs 3.6 days for Module A).",
        confort:
          "Thermal comfort priority: chassis with 24 cm cellulose insulation (U 0.162) combined with the active Climate Kit.",
        coste:
          "Cost priority: maximize the % of grid-connected Module B units (27,400 €/module vs 33,530 € for Module A).",
        emisiones:
          "Emissions priority: Module B reduces footprint to 11.5 t CO₂/module (compared to 13.3 t CO₂ for Module A with battery and solar).",
        autosuficiencia:
          "Self-sufficiency priority: prioritize Module A (14 m² solar panels + 10 kWh battery) for off-grid operation.",
      };

      function renderNotices() {
        const accesoCamion = el("accesoCamion").value;
        const requisitoPrioritario = el("requisitoPrioritario").value;
        const isLimited = accesoCamion === "limitado";

        const notices = [
          isLimited
            ? {
                variant: "danger",
                title: "Limited logistics access",
                text: "Heavy trailer cannot access: requires palletized transport of disassembled panels using a light vehicle or local crane.",
              }
            : {
                variant: "info",
                title: "Standard logistics access",
                text: "Direct access with a standard crane truck right to the assembly point.",
              },
          {
            variant: "info",
            title: `Priority criterion · ${PRIORITY_LABELS[requisitoPrioritario] ?? PRIORITY_LABELS.confort}`,
            text:
              PRIORITY_GUIDANCE[requisitoPrioritario] ??
              PRIORITY_GUIDANCE.confort,
          },
        ];

        el("operationalNotices").replaceChildren(
          ...notices.map((notice) => {
            const div = document.createElement("div");
            div.className = `aviso aviso-${notice.variant}`;
            const strong = document.createElement("strong");
            strong.textContent = `${notice.title}: `;
            div.append(strong, document.createTextNode(notice.text));
            return div;
          }),
        );
      }

      function renderKit(escenarioId) {
        const kitKey = SCENARIO_KIT[escenarioId] ?? "calor";
        const kit = KITS[kitKey];
        if (!kit) return;

        const badge = el("kitBadge");
        badge.textContent = kit.badge;
        badge.className = `kit-badge kit-badge-${kit.id}`;

        el("kitTitle").textContent = kit.nom;
        el("kitSubtitle").textContent = kit.subtitol;

        const kpis = el("kitKpis");
        kpis.replaceChildren(
          ...kit.kpis.map((kpi) => {
            const box = document.createElement("div");
            box.className = `kit-kpi kit-kpi-${kit.id}`;
            const val = document.createElement("div");
            val.className = "kit-kpi-val";
            val.textContent = kpi.val;
            const txt = document.createElement("div");
            txt.className = "kit-kpi-txt";
            txt.textContent = kpi.txt;
            box.append(val, txt);
            return box;
          }),
        );

        const list = el("kitList");
        list.replaceChildren(
          ...kit.components.map((item) => {
            const li = document.createElement("li");
            li.textContent = item;
            return li;
          }),
        );
      }

      // En canviar el clima manualment, també s'actualitza el kit
      el("escenarioId").addEventListener("change", () => {
        renderKit(el("escenarioId").value);
      });

      el("personasAfectadas").addEventListener("input", renderCost);
      el("duracionEstanciaDias").addEventListener("input", renderCost);
      el("plazoMaximoDias").addEventListener("input", renderCost);
      el("presupuestoTotalEur").addEventListener("input", renderCost);
      el("stockModulos").addEventListener("input", renderCost);
      el("percentModulesA").addEventListener("input", renderCost);
      el("accesoCamion").addEventListener("change", renderNotices);
      el("requisitoPrioritario").addEventListener("change", renderNotices);

      function switchTab(activeTab) {
        const isDashboard = activeTab === "dashboard";
        el("panelDashboard").hidden = !isDashboard;
        el("panelFormulas").hidden = isDashboard;
        el("tabDashboard").classList.toggle("is-active", isDashboard);
        el("tabFormulas").classList.toggle("is-active", !isDashboard);
        el("tabDashboard").setAttribute("aria-selected", String(isDashboard));
        el("tabFormulas").setAttribute("aria-selected", String(!isDashboard));
      }

      el("tabDashboard").addEventListener("click", () =>
        switchTab("dashboard"),
      );
      el("tabFormulas").addEventListener("click", () => switchTab("formulas"));
    </script>
  </body>
</html>
